' Ouvrage : 6 - Livre Blanc
' Figure : Fig. 30 (p. 116)
' Légende : Contraste topologique entre orchestration dirigée et dérive « flipper » en chorégraphie pure

@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontColor #0F172A
}
skinparam rectangle {
  BackgroundColor #F1F6F9
  BorderColor #2B4C65
  FontColor #0F172A
  RoundCorner 4
}
skinparam queue {
  BackgroundColor #F1F6F9
  BorderColor #2B4C65
  FontColor #0F172A
}
skinparam arrow {
  Color #2B4C65
  FontColor #0F172A
}

left to right direction

package "A. Orchestration dirigée (Process\nManager explicite)" {
  rectangle "Déclencheur\nmétier" as trig
  rectangle "Orchestrateur\nd'état\n(Process Manager)" as pm
  together {
    rectangle "Agent C\n(Validation)" as agC
    rectangle "Agent B\n(Risque)" as agB
    rectangle "Agent A\n(Extraction)" as agA
  }

  trig --> pm : 1. Démarre\ninstance
  pm --> agC : 4. Commande\nfinale
  pm --> agB : 3. Commande\nsuivante
  pm --> agA : 2. Commande\ncorrélée
  agC -[hidden]right-> agB
  agB -[hidden]right-> agA
}

package "B. Chorégraphie pure non bornée\n(Dérive « Pinball Machine »)" {
  rectangle "Événement\ninitial" as evt
  queue "Event Mesh\n(Sujets partagés)" as em
  together {
    rectangle "Agent Z\n(Décision)" as agZ
    rectangle "Agent Y\n(Enrichissement)" as agY
    rectangle "Agent X\n(Triage)" as agX
  }

  evt --> em : Émet fait
  em --> agZ : Réagit
  em <-[#C0392B,dashed]- agZ : Écho implicite\n(boucle / état diffus)
  em --> agY : Réagit
  em <-- agY : Ré-émet
  em --> agX : Réagit
  em <-- agX : Ré-émet
  agZ -[hidden]right-> agY
  agY -[hidden]right-> agX
}

pm -[hidden]down-> evt

@enduml
