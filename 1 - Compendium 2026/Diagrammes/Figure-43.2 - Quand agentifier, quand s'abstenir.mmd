%% Figure 43.2 — Quand agentifier, quand s'abstenir
%%{init: {'flowchart': {'wrappingWidth': 1150}}}%%
flowchart TB
    subgraph ARBRE["LA QUESTION SE POSE AVANT L'ARCHITECTURE"]
        Q["<b>L'enchaînement peut-il être décidé d'avance ?</b>"]
        OUI["<b>S'abstenir</b><br/>un cadre déterministe fait le travail,<br/>à coût prévisible et chemin testable · ch. 22 § 22.5"]
        NON["<b>Agentifier, encadré</b><br/>le non-déterminisme apporte une valeur,<br/>et l'encadrement en borne le domaine · OO3 ou OO4"]
        SEUIL["<b>Ne pas franchir</b><br/>autorisation et règlement restent déterministes ·<br/>ch. 36 § 36.2.1"]
        Q -->|"oui"| OUI
        Q -->|"non"| NON
        Q -->|"au seuil d'irréversibilité"| SEUIL
    end

    NOTE["La grille est un CRITÈRE D'AUTEUR : le socle ne porte pas de règle d'abstention. Elle réordonne ce que les chapitres établissent ·<br/>elle n'ajoute pas d'exigence, et elle ne dispense d'aucune."]
