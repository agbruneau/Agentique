%%{init: {'flowchart': {'wrappingWidth': 1150}}}%%
flowchart TB
    subgraph CHAINE["LE MANDAT D'ORIGINE EST RETIRÉ — ET CE QUI EN A ÉTÉ DÉRIVÉ ?"]
        direction LR
        M["<b>Mandant</b><br/>retire l'autorisation qu'il avait<br/>accordée"]
        A1["<b>Agent</b><br/>détenait le mandat, l'avait<br/>transmis"]
