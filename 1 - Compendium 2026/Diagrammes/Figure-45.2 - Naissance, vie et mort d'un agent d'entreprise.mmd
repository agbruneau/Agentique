%% Figure 45.2 — Naissance, vie et mort d'un agent d'entreprise
%%{init: {'flowchart': {'wrappingWidth': 1150}}}%%
flowchart TB
    subgraph FRISE["TROIS TEMPS, ET LE DERNIER EST LE MOINS OUTILLÉ"]
        direction LR
        T1["<b>● Naissance · Enregistrement</b><br/>émission du passeport, admission au<br/>maillage — § 45.8"]
        T2["<b>● Vie · Délégations</b><br/>vérifications par arête, traces,<br/>évaluations, renouvellements, migration<br/>post-quantique — § 45.9"]
        T3["<b>○ Mort · Révocation</b><br/>cascade dans la chaîne de mandat,<br/>retrait du maillage, archivage<br/>probatoire — § 45.10"]
        T1 --> T2 --> T3
    end

    NOTE["Convention graphique : ● nœud plein = temps outillé ; ○ nœud ouvert = temps le moins outillé ou à venir.<br/>La mort est la partie la moins outillée : la révocation en cascade n'est pas documentée (ch. 20 § 20.6),<br/>et l'archivage probatoire suppose une trace qui vaille pièce — ce que le ch. 38 § 38.4 déclare dissymétrique au socle."]
    FRISE ~~~ NOTE

    classDef plein fill:#8B2E0B,stroke:#8B2E0B,color:#FFFFFF,text-align:left
    classDef ouvert fill:#FFFFFF,stroke:#8B2E0B,stroke-width:2px,color:#222222,text-align:left
    classDef note fill:#FBF9F5,stroke:#CCCCCC,color:#444444,text-align:left
    class T1,T2 plein
    class T3 ouvert
    class NOTE note
    style FRISE fill:#FAF8F5,stroke:#8B2E0B,color:#8B2E0B
