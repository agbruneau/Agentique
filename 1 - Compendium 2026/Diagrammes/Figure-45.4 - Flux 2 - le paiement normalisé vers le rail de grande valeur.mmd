%% Figure 45.4 — Flux 2 — le paiement normalisé vers le rail de grande valeur
flowchart TB
    subgraph FLUX2["L'AGENT S'ARRÊTE AVANT LE SEUIL"]
        direction LR
        E1["<b>Intention</b><br/>l'agent interprète,<br/>compose, prépare"]
        E2["<b>Instruction</b><br/>normalisée, validable<br/>par schéma"]
        E3["<b>Rail</b><br/>exécute, de façon<br/>déterministe"]
        E4["<b>Observation</b><br/>l'agent lit ce qui<br/>s'est passé"]
        E1 --> E2 --> E3 -.-|"×"| E4
    end

    SEUIL["<b>Le seuil de finalité : l'agent observe, il ne franchit pas.</b>"]
    NOTE["L'AGENT N'EXÉCUTE PAS. Le rail est déterministe et le reste :<br/>c'est l'application directe de la stratification du ch. 36 § 36.2.1<br/>et du seuil d'irréversibilité du ch. 31 § 31.1.1."]
