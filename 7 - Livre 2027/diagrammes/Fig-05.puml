@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 20
skinparam ranksep 20
skinparam padding 5

rectangle "Effondrement des coûts de transaction (Coase)\nrecherche, négociation et vérification accélérées" as COASE <<ext>>

package "Matrice des économies d'agents (Tomašev et al.)" {
  rectangle "Émergente × Perméable\n(cascades systémiques et capture)" as Q1 <<prob>>
  rectangle "Émergente × Imperméable\n(banc d'observation isolé)" as Q2 <<prob>>
  rectangle "Conçue × Perméable\n(marché gouverné sous mandats)" as Q3 <<det>>
  rectangle "Conçue × Imperméable\n(simulateur hermétique d'audit)" as Q4 <<det>>
}

rectangle "Asymétrie SaaS fermée\n(ouvert sur le fil, opaque au contrôle)" as SAAS <<prob>>

package "Garde-fous institutionnels de la firme" {
  rectangle "Plafonds d'engagement\net coupe-circuit financier" as G1 <<det>>
  rectangle "Identité et imputation\ncontractuelle explicite" as G2 <<det>>
  rectangle "Médiation sémantique\ninter-organisations" as G3 <<det>>
  rectangle "Frontière souveraine\ndu plan de contrôle" as G4 <<det>>
}

COASE --> Q1 : sans règles
COASE --> Q3 : sous architecture
Q1 ..> SAAS : fragilité partagée
Q1 --> G1 : impose
Q3 --> G2
Q3 --> G3
Q4 --> G4
G1 --> G4
G2 --> G4
G3 --> G4

Q1 -[hidden]right-> Q2
Q3 -[hidden]right-> Q4
Q1 -[hidden]down-> Q3
Q2 -[hidden]down-> Q4
G1 -[hidden]right-> G2
G2 -[hidden]right-> G3

legend bottom
  **Trait plein ardoise** : frontière déterministe possédée
  **Trait pointillé ambre** : composant probabiliste substituable
end legend
@enduml
