@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle frame
skinparam nodesep 14
skinparam ranksep 18
skinparam padding 5

package "Socle sans regret (2027–2032)" {
  rectangle "2027 : Noyau sans regret\n(80/20, NHI, journal)" as S27 <<det>>
  rectangle "2027–2029 : Collision PKI\n(TLS 100 j → 47 j mars 2029)" as PKI <<det>>
  rectangle "Agilité cryptographique\net passerelles adaptables" as AGIL <<det>>
  rectangle "2030–2032 : Transition PQC\n(ML-DSA ~52–72× plus lourd)" as PQC <<det>>
  rectangle "Capteurs de signaux\net portes budgétaires DAPP" as SIG <<det>>
}

package "Bifurcations (2028–2035)" {
  rectangle "Scénario A : Socle\nouvert (MCP / A2A)" as SA <<prob>>
  rectangle "Scénario B : Archipel\nde suites fermées" as SB <<prob>>
  rectangle "Scénario C : Blocs\nsouverains isolés" as SC <<prob>>
  rectangle "Option A : Fédérations\nouvertes vérifiables" as OA <<det>>
  rectangle "Option B : Couches\nd'extraction multi-modèles" as OB <<det>>
  rectangle "Option C : Inférence\nlocale souveraine" as OC <<det>>
}

rectangle "Horizon 2035 : Achèvement PQC G7 et autonomie gouvernée" as H35 <<det>>

S27 --> PKI
PKI --> AGIL : automatisation
AGIL --> PQC : absorption taille
S27 --> SIG : veille budgétée
SIG ..> SA
SIG ..> SB
SIG ..> SC
SA --> OA
SB --> OB
SC --> OC
OA --> H35
OB --> H35
OC --> H35
PQC --> H35

S27 -[hidden]right-> PKI
PKI -[hidden]right-> AGIL
SA -[hidden]right-> SB
SB -[hidden]right-> SC
OA -[hidden]right-> OB
OB -[hidden]right-> OC

legend bottom
  **Trait plein ardoise** : frontière déterministe possédée
  **Trait pointillé ambre** : composant probabiliste substituable
end legend
@enduml
