@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 14
skinparam ranksep 20
skinparam padding 5

actor "Superviseur humain\n(imputabilité finale)" as HUM <<ext>>
rectangle "Modèles et agents substituables\n(« qui parle »)" as MOD <<prob>>

package "Tissu conjonctif agentique (« qui en répond »)" {
  rectangle "Plan d'orchestration déterministe\n(état, bornes, règle du maillon le plus élevé)" as ORCH <<det>>
  rectangle "D1. Connectivité\nverticale outils" as D1 <<det>>
  rectangle "D2. Sémantique\net mémoire" as D2 <<det>>
  rectangle "D3. Coordination\nentre pairs" as D3 <<det>>
  rectangle "D4. Événements\net état durable" as D4 <<det>>
  rectangle "D5. Interaction\nhumain-agent" as D5 <<det>>
  rectangle "D6. Gouvernance\ncontractuelle B2B" as D6 <<det>>
}

rectangle "Fabrique de confiance\n(identité, sécurité, preuve)" as CONF <<det>>
rectangle "Économie du résultat\n(coût conforme, constance)" as ECO <<det>>
database "Patrimoine applicatif\n(CRM, ERP, ITSM, dépôts)" as PAT <<ext>>

HUM --> D5 : mandat
HUM --> ORCH : seuils
MOD <--> ORCH : appels typés
ORCH --> D1
ORCH --> D2
ORCH --> D3
D1 -[hidden]down-> D4
D2 -[hidden]down-> D5
D3 -[hidden]down-> D6
ORCH --> D4
ORCH --> D5
ORCH --> D6
D1 --> PAT
D2 --> PAT
D4 --> CONF
D6 --> ECO

MOD -[hidden]right-> HUM
D1 -[hidden]right-> D2
D2 -[hidden]right-> D3
D4 -[hidden]right-> D5
D5 -[hidden]right-> D6
CONF -[hidden]right-> PAT
PAT -[hidden]right-> ECO

legend bottom
  **Trait plein ardoise** : frontière déterministe possédée
  **Trait pointillé ambre** : composant probabiliste substituable
end legend
@enduml
