@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle frame
skinparam nodesep 24
skinparam ranksep 24
skinparam padding 7

rectangle "Agent orchestrateur interne\n(raisonnement borné)" as AGT <<prob>>
rectangle "Anti-patron rejeté :\nSwagger-to-MCP brut (300 API)" as ANTI <<prob>>

package "Médiation possédée" {
  rectangle "Registre d'outils\népinglés" as REG <<det>>
  rectangle "Passerelle MCP durcie\n(interfaces ACI)" as MCP <<det>>
  rectangle "Passerelle A2A gouvernée\n(contrats et mandats)" as A2A <<det>>
  rectangle "Bus d'événements\n(CloudEvents)" as EVT <<det>>
  rectangle "Couche sémantique\net ontologies" as SEM <<det>>
  rectangle "Validateur de schémas\net décimales exactes" as VAL <<det>>
  rectangle "Couche anti-corruption\n(ACL patrimoniale)" as ACL <<det>>
}

database "Outils métier\ngranulaires (APIs)" as TOOLS <<ext>>
database "Patrimoine central\n(mainframe, ERP)" as LEGACY <<ext>>
rectangle "Agent pair externe\n(échange de tâches A2A)" as PEER <<prob>>

ANTI ..> AGT : sature le contexte
AGT --> MCP : médiation verticale
AGT --> A2A : délégation horizontale
AGT --> EVT : états asynchrones
REG --> MCP : épingle intégrité
MCP --> SEM
SEM --> VAL
VAL --> TOOLS : appel granulaire
VAL --> ACL : traduction sûre
ACL --> LEGACY : écriture exacte
EVT --> A2A : déclenchement
A2A <--> PEER

AGT -[hidden]right-> ANTI
MCP -[hidden]right-> A2A
A2A -[hidden]right-> EVT
TOOLS -[hidden]right-> LEGACY
LEGACY -[hidden]right-> PEER

legend bottom
  **Trait plein ardoise** : frontière déterministe possédée
  **Trait pointillé ambre** : composant probabiliste substituable
end legend
@enduml
