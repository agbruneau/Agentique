@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle frame
skinparam nodesep 24
skinparam ranksep 24
skinparam padding 7

rectangle "Entrée métier typée\n(dossier et mandat)" as IN <<det>>

package "Harnais 80/20" {
  rectangle "1. Validation d'entrée\net vérification de portée" as VALIN <<det>>
  rectangle "2. Assemblage borné\ndu contexte filtré" as CTX <<det>>
  rectangle "3. Contrôleur de budget\net de tours max" as BUD <<det>>
  rectangle "4. Inférence probabiliste\ndu modèle (~20 %)" as LLM <<prob>>

  rectangle "5. Décodage contraint\n(grammaire JSON stricte)" as DEC <<det>>
  rectangle "6. Validateur de schéma\net d'invariants métier" as VALOUT <<det>>
  rectangle "7. Porte de politique\nhors modèle" as GATE <<det>>
  rectangle "8. Médiateur d'outils\ntypés et isolés" as TOOL <<det>>
  rectangle "Repli déterministe\n(rejet ou escalade)" as REPLI <<det>>
  database "Journal de preuve\n(entrée, schéma, décision)" as LOG <<det>>
}

IN --> VALIN
VALIN --> CTX
CTX --> BUD
BUD --> LLM : appel borné
LLM -right-> DEC : jetons bruts
DEC -up-> VALOUT
VALOUT -up-> GATE : conforme
VALOUT --> REPLI : hors schéma
GATE -up-> TOOL : permis
GATE --> REPLI : refusé
TOOL --> LOG : trace\nscellée
REPLI --> LOG : incident\nscellé

VALIN -[hidden]right-> TOOL
CTX -[hidden]right-> GATE
BUD -[hidden]right-> VALOUT

legend bottom
  **Trait plein ardoise** : frontière déterministe possédée
  **Trait pointillé ambre** : composant probabiliste substituable
end legend
@enduml
