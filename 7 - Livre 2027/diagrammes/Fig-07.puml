@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 14
skinparam ranksep 20
skinparam padding 5

rectangle "Systèmes d'engagement (SoE)\ninterfaces et canaux métiers" as SOE <<ext>>

package "Noyau de contrôle déterministe possédé (~80 %)" {
  rectangle "Systèmes d'agence (SoA)\nlogique métier et états explicites" as SOA <<det>>
  rectangle "Plan 1 : Registre et\nidentités NHI" as P1 <<det>>
  rectangle "Plan 2 : Passerelle\nde politiques" as P2 <<det>>
  rectangle "Plan 3 : Mémoire\ngouvernée" as P3 <<det>>
  rectangle "Plan 4 : Journal de\npreuve durable" as P4 <<det>>
  rectangle "Routeur d'inférence\nagnostique" as RTR <<det>>
}

package "Modèles substituables (~20 %)" {
  rectangle "Modèle externe A\n(infonuagique)" as MA <<prob>>
  rectangle "Modèle B\n(bascule qualifiée)" as MB <<prob>>
}

rectangle "Couche anti-corruption\n(ACL patrimoniale)" as ACL <<det>>
database "Systèmes d'autorité (SoR)\ndonnées centrales" as SOR <<ext>>

SOE --> SOA : requête
SOA --> P1
SOA --> P2
SOA --> P3
SOA --> P4
P1 -[hidden]down-> P3
P2 -[hidden]down-> P4
SOA --> RTR : appel typé
RTR ..> MA : actif
RTR ..> MB : repli
P2 --> ACL : autorisé
ACL --> SOR : mutation fiable

P1 -[hidden]right-> P2
P3 -[hidden]right-> P4
MA -[hidden]right-> MB
RTR -[hidden]right-> ACL

legend bottom
  **Trait plein ardoise** : frontière déterministe possédée
  **Trait pointillé ambre** : composant probabiliste substituable
end legend
@enduml
