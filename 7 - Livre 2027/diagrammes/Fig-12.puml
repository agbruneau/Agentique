@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 16
skinparam ranksep 24
skinparam padding 6

package "Moteur d'exécution durable" {
  database "Journal d'événements\n(rejeu déterministe sans perte)" as LOG <<det>>
  rectangle "Clé d'idempotence canonique\n(anti-double écriture)" as IDEM <<det>>
}

package "Flux direct de la Saga" {
  rectangle "Synthèse préparatoire\n(appel probabiliste)" as PREP <<prob>>
  rectangle "T1 : Réservation locale\n(compensable)" as T1 <<det>>
  rectangle "T2 : Engagement intermédiaire\n(compensable)" as T2 <<det>>
  rectangle "Garde du point pivot\n(validation d'invariants)" as GARDE <<det>>
  rectangle "TP : Point pivot irréversible\n(acte critique scellé)" as PIVOT <<det>>
  rectangle "T3 : Finalisation post-pivot\n(reprise garantie)" as T3 <<det>>
}

package "Protection et reprise isolée" {
  rectangle "Coupe-circuit du flux direct\n(arrêt des nouvelles actions)" as CC <<det>>
  rectangle "Canal de compensation isolé\n(jamais bloqué par l'arrêt d'urgence)" as COMP <<det>>
  rectangle "Actions inverses ordonnées\n(C2 puis C1 idempotentes)" as INV <<det>>
}

LOG --> T1 : persiste état
IDEM --> T1 : verrouille effet
PREP --> T1 : proposition typée
T1 --> T2
T2 --> GARDE
GARDE --> PIVOT : invariants validés
PIVOT --> T3 : succès durable
GARDE --> CC : anomalie pré-pivot
CC --> COMP : déclenche repli
COMP --> INV : exécute C2 → C1
INV --> LOG : clôt dossier compensé

LOG -[hidden]right-> IDEM
CC -[hidden]right-> COMP

legend bottom
  **Trait plein ardoise** : frontière déterministe possédée
  **Trait pointillé ambre** : composant probabiliste substituable
end legend
@enduml
