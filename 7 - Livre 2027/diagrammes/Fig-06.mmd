%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'DejaVu Sans', 'fontSize': '14px', 'lineColor': '#334155', 'edgeLabelBackground': '#FFFFFF', 'primaryTextColor': '#0F2942'}}}%%
flowchart TD
  D1{"Cas d'usage différenciant<br/>ou critique pour le mandat ?"}:::det
  D2{"L'éditeur ouvre-t-il le plan<br/>de contrôle et la piste d'audit ?"}:::det
  D3{"Coût de sortie et portabilité<br/>des données acceptables ?"}:::det
  A1["Acheter en SaaS<br/>(usage banalisé ou lecture seule)"]:::prob
  A2["Exiger sas contractuel,<br/>export et plafond d'actions"]:::det
  R1["Rejeter l'agent captif<br/>ou confiner en boîte isolée"]:::det
  D4{"Standards ouverts MCP / A2A<br/>suffisants avec harnais interne ?"}:::det
  A3["Assembler sur standards ouverts<br/>(posture par défaut 80/20)"]:::det
  D5{"Actif métier propriétaire ou<br/>contrainte de souveraineté ?"}:::det
  A4["Construire le noyau métier<br/>et la couche sémantique"]:::det
  M1["Modèle de fondation substituable<br/>(externe ou hébergé)"]:::prob

  D1 -->|Non| D2
  D1 -->|Oui| D4
  D2 -->|Oui| D3
  D2 -->|Non| R1
  D3 -->|Oui| A1
  D3 -->|Non| A2
  D4 -->|Oui| A3
  D4 -->|Non| D5
  D5 -->|Oui| A4
  D5 -->|Non| A3
  A3 -.->|inférence bornée| M1
  A4 -.->|inférence bornée| M1

  classDef det fill:#EBF2F7,stroke:#1E4E79,stroke-width:2.5px,color:#0F2942,font-weight:bold
  classDef prob fill:#FFF5E0,stroke:#B45309,stroke-width:2px,stroke-dasharray:6 4,color:#451A03
