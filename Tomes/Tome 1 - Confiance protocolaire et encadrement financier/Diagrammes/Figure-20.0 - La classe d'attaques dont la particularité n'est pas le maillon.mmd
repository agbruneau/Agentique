%% Figure 20.0 — La classe d’attaques dont la particularité n’est pas le maillon mais le moment.
%%{init: {'flowchart': {'wrappingWidth': 900}}}%%
flowchart TB
    subgraph FRISE["L'ADMISSION RÉUSSIT, PUIS L'OBJET CHANGE"]
        direction LR
        T0["<b>t0 — Publication</b><br/>un serveur d'outils est<br/>publié, décrit, référencé"]
        T1["<b>t1 — Admission</b><br/>le mécanisme fonctionne, le<br/>verdict est rendu"]
        T2["<b>t2 — Usage</b><br/>l'agent l'invoque sur la foi<br/>du verdict de t1"]
        T3["<b>t3 — Retournement</b><br/>l'objet vérifié change — et<br/>rien ne re-pose la question"]
        T0 --> T1 --> T2 --> T3
    end

    NOTE["L'attaque NE DÉFAIT PAS la vérification : elle attend qu'elle soit faite. La question qu'elle pose n'est donc pas celle de la<br/>robustesse du mécanisme d'admission, mais celle de la DURÉE DE VALIDITÉ d'un verdict que rien ne borne."]

