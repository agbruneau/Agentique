flowchart TB
    subgraph FRISE["QUATRE JALONS DOCUMENTÉS, ET AUCUNE CONTINUITÉ"]
        direction LR
        M1["<b>2012 — RFC 6749</b><br/>le détenteur de ressource est « une entité » ;<br/>« utilisateur final » est réservé<br/>au cas où c'est une personne"]
