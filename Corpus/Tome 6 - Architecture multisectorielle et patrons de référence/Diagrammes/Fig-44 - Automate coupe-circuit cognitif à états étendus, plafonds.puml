' Ouvrage : 6 - Livre Blanc
' Figure : Fig. 44 (page 166)
' Légende : Fig. 44. – Automate coupe-circuit cognitif à états étendus, plafonds de profondeur et repli déterministe
@startuml
skinparam backgroundColor #ffffff
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName SansSerif
skinparam ArrowColor #324e67
skinparam ArrowFontColor #172025
skinparam StateBackgroundColor #f3f7f9
skinparam StateBorderColor #324e67
skinparam StateFontColor #172025

state "METRICS_ONLY\n(Calibration silencieuse)" as METRICS_ONLY
state "CLOSED\n(Exécution nominale sous\nmax_turns / recursion_limit)" as CLOSED
state "OPEN\n(Coupure cognitive immédiate :\nrepli déterministe L0 / HITL)" as OPEN
state "HALF_OPEN\n(Sondes canari bornées\nvalidées par Tier 1)" as HALF_OPEN
state "FORCED_OPEN\n(Arrêt d'urgence opérateur\nou alerte ASI10)" as FORCED_OPEN

[*] --> METRICS_ONLY : Déploiement\nmode ombre
METRICS_ONLY --> CLOSED : Seuils validés\n(promotion prod)
CLOSED --> OPEN : Répétition hachage >= N\nou budget / dérive / erreurs >= seuil
CLOSED --> FORCED_OPEN : Kill-switch manuel\nou mandat violé (ASI10)
OPEN --> FORCED_OPEN : Escalade incident\nsystémique (ASI08)
OPEN --> HALF_OPEN : Expiration délai\nrefroidissement
FORCED_OPEN --> HALF_OPEN : Réarmement autorisé\naprès correctif
HALF_OPEN --> OPEN : Échec ou lenteur\nd'une sonde
HALF_OPEN --> CLOSED : Sondes saines\n(succès Tier 1)
@enduml
