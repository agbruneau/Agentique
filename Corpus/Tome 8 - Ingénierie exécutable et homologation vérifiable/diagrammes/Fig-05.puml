@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 11
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 28
skinparam ranksep 36
skinparam padding 7

rectangle "Source externe non fiable\n(courriel, web, outil tiers)" as EXT_IN <<prob>>
rectangle "Agent appelant probabiliste\n(requête d'outil ou délégation A2A)" as AGT <<prob>>
rectangle "Suivi de contamination CaMeL\n(consumed_untrusted, propagation A2A)" as TAINT <<det>>
rectangle "Preuve CIBA / JCS & MoneyAmount\n(Decimal exact, refus IEEE-754 float)" as CIBA_IN <<det>>

package "OPA / Rego" {
  rectangle "rule_of_two.rego (EXIG-SEC-06)\nbloque trifecta sans approbation CIBA" as R2 <<det>>
  rectangle "camel_taint.rego\ncontrôle flot TRUSTED_PLAN vs données" as CML <<det>>
  rectangle "sandbox_confinement.rego\nvalide quotas, secrets et réseau" as SBX_R <<det>>
}

rectangle "Vérification G0 : opa test --coverage\n(100 % négatifs) & OWASP SRC-055" as OPA_CI <<ext>>
rectangle "Refus déterministe (allow = false)\net journalisation échec fermé" as DENY <<det>>

package "Confinement sans KVM (EXIG-SEC-12..15)" {
  rectangle "Blocage IMDS & plages IANA\n(network: none / allowlist sans joker)" as NET <<det>>
  rectangle "Racine lecture seule, 0 secret\net délais 30 s / 20 min / 60 min" as LIM <<det>>
}

rectangle "Exécution bornée autorisée\n(outils P0–P3 sous garde)" as ALLOW <<det>>

EXT_IN .[#B45309].> AGT : données non fiables
EXT_IN .[#B45309].> TAINT : marque UNTRUSTED
AGT .[#B45309].> R2 : demande d'outil
CIBA_IN -right-> R2 : action_sha256\n& Decimal
TAINT --> R2 : état contamination
TAINT --> CML : provenance A2A
R2 --> CML : règle de deux OK
CML --> SBX_R : flot sain
R2 --> DENY : trifecta / défaut
CML --> DENY : flot contaminé
SBX_R --> DENY : IMDS / secret / délai
SBX_R --> NET : manifeste\nvalide
NET --> LIM : quotas & délais
LIM --> ALLOW
OPA_CI -left-> SBX_R : certifie 100 %

EXT_IN -[hidden]right-> AGT
CIBA_IN -[hidden]right-> R2
TAINT -[hidden]right-> OPA_CI
DENY -[hidden]right-> NET

legend bottom
  **Trait plein ardoise** : frontière déterministe hors modèle possédée (G0)
  **Trait pointillé ambre** : agent probabiliste substituable ou source externe non fiable
  **Trait plein gris** : vérification statique/couverture et corpus OWASP SRC-055
end legend
@enduml
