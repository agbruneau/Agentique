@startuml
top to bottom direction
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName SansSerif
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 16

title
<b>Chaîne multi-sauts, choc PKI / ML-DSA et double couloir d’audit</b>
<size:11><color:#475569>RFC 8693 + DPoP/mTLS, parades HTTP 431 (kid, SCITT) et OTel vs audit JCS</color></size>
end title

rectangle "<color:#1D4ED8><b>1. Délégation atténuée ≤ 2 sauts (EXIG-IAM-08..16, CAEP ≤ 15 min)</b></color>" as T1 #FFFFFF;line:2563EB {
  rectangle "<b>1. Mandant humain</b>\nSession auth. · sub initial\nAnti-détournement PIM" as M1 #F8FAFC;line:0F172A
  rectangle "<color:#1D4ED8><b>2. Agent A (Saut 1)</b></color>\nSPIFFE SVID + RFC 8693 #1\naud=B + DPoP / mTLS" as M2 #EFF6FF;line:2563EB
  rectangle "<color:#1D4ED8><b>3. Agent B (Saut 2 max)</b></color>\nsub gardé + act empilé\nPortées ⊆ #1 + RAR" as M3 #EFF6FF;line:2563EB
  rectangle "<color:#166534><b>4. Cible via PEP</b></color>\nVérifie aud & preuve cnf\nProf. ≤ 2 · zéro relais" as M4 #ECFDF5;line:16A34A

  M1 -[#2563EB]right-> M2
  M3 -[#2563EB]right-> M4
  M1 -[hidden]down-> M3
  M2 -[hidden]down-> M4
}

together {
  rectangle "<color:#991B1B><b>2a. Choc PKI 47 j & ML-DSA</b></color>\n• TLS : 100 j → 47 j (2029)\n• ML-DSA : 3,3–4,6 Ko (72×)\n• 3 sauts = 20 à 35 Ko\n• Rejet HTTP 431 (8–16 Ko)\n• PQC G7 : 2030–2035 [A]" as P2A #FEF2F2;line:991B1B

  rectangle "<color:#6D28D9><b>2b. Parades P1–P2 (CAP-040)</b></color>\n(1) Clés par réf. kid / JWKS\n     & passerelles ≥ 32 Ko\n(2) Transaction Tokens & COSE\n(3) TLS 1.3 hybride + ACME\n(4) Merkle SCITT · SLH-DSA" as P2B #F5F3FF;line:6D28D9

  P2A -[#6D28D9]right-> P2B
}

rectangle "<color:#1D4ED8><b>3a. OTel Couloir 1 · Opérationnel</b></color>\nv1.41.0 épinglé · zéro contenu brut (OBS-07) · SHA-256 poivré" as C3A #EFF6FF;line:2563EB
rectangle "<color:#9A3412><b>3b. Couloir 2 · Débogage / forensique</b></color>\n« Bris de glace » double accord · purge ≤ 14 j (OBS-08) · art. 12.1 ≥ 1 an" as C3B #FFF7ED;line:C2410C
rectangle "<color:#166534><b>3c. Journal d’audit probatoire JCS</b></color>\n5 champs RFC 8785 avant relais P2/P3 · ancré/h · ≥ 24 m (RPRP)" as C3C #ECFDF5;line:16A34A

M3 -[hidden]down-> P2A
M4 -[hidden]down-> P2B
P2A -[hidden]down-> C3A
P2B -[hidden]down-> C3A
C3A -[hidden]down-> C3B
C3B -[hidden]down-> C3C
@enduml
