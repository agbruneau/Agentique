@startuml
top to bottom direction
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName "Segoe UI"
skinparam Padding 8
skinparam nodesep 20
skinparam ranksep 10
skinparam rectangle<<invis>> {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
  FontSize 1
}

rectangle "Workflow : chemins de code prédéfinis" as AxL #FFFFFF;line:FFFFFF
rectangle " " as AxMid <<invis>>
rectangle "Agent : le modèle dirige son processus" as AxR #FFFFFF;line:FFFFFF
AxL -[hidden]right-> AxMid
AxMid -[hidden]right-> AxR
AxL <-[#64748B,norank]-> AxR

rectangle Matrice #FFFFFF;line:FFFFFF [
  |=  |= **Workflow** |= **Étapes agentiques** |= <color:#2563EB>¦</color> |= **Agent borné** |= **Agent ouvert** |
  | <#FFFFFF>**Qui décide du chemin** | <#F8FAFC>**Le concepteur**\nentièrement | <#F8FAFC>**Le concepteur**\nentre les étapes | <#EFF6FF><color:#2563EB>¦</color> | <#EFF6FF>**Le modèle**\ndans une région\ndélimitée | <#EFF6FF>**Le modèle** |
  | <#FFFFFF>**Ce que décide le modèle** | <#FFFFFF>Le contenu d'une\nétape : classer,\nextraire, rédiger | <#FFFFFF>La conduite d'une\nétape, outils\ncompris | <#EFF6FF><color:#2563EB>¦</color> | <#FFFFFF>Outils, ordre et\nparamètres, dans une\nliste fermée et sous\nun plafond | <#FFFFFF>Le plan, les outils,\nle critère d'arrêt |
]

rectangle Frontiere #FFFFFF;line:FFFFFF [
  <color:#2563EB>**Frontière de visibilité**</color>
  //le processus ne voit que l'entrée et la sortie//    |    //chaque appel d'outil est une activité du processus//
]

AxMid -[hidden]down-> Matrice
Matrice -[hidden]down-> Frontiere

@enduml
