rectangle "Le plan, les outils,\nle critère d'arrêt" as D4 #FFFFFF;line:94A3B8

rectangle "//le processus ne voit que l'entrée et la sortie//" as Foot1 #FFFFFF;line:FFFFFF
rectangle "//chaque appel d'outil est une activité du processus//" as Foot2 #FFFFFF;line:FFFFFF

AxL -[hidden]down-> T1
AxR -[hidden]down-> T4

H0 -[hidden]right-> T1
