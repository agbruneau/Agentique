AxL <-[#64748B]right-> AxR

rectangle " " as H0 #FFFFFF;line:FFFFFF
rectangle "**Workflow**" as T1 #FFFFFF;line:FFFFFF
rectangle "**Étapes agentiques**" as T2 #FFFFFF;line:FFFFFF
rectangle " " as V0 #FFFFFF;line:FFFFFF
rectangle "**Agent borné**" as T3 #FFFFFF;line:FFFFFF
rectangle "**Agent ouvert**" as T4 #FFFFFF;line:FFFFFF

rectangle "**Qui décide du chemin**" as H1 #FFFFFF;line:FFFFFF
rectangle "**Le concepteur**\nentièrement" as P1 #F8FAFC;line:64748B
rectangle "**Le concepteur**\nentre les étapes" as P2 #F8FAFC;line:64748B
rectangle "**Frontière de visibilité**" as Vis #FFFFFF;line:2563EB;line.dashed
rectangle "**Le modèle**\ndans une région\ndélimitée" as P3 #EFF6FF;line:2563EB
rectangle "**Le modèle**" as P4 #EFF6FF;line:2563EB

rectangle "**Ce que décide le modèle**" as H2 #FFFFFF;line:FFFFFF
