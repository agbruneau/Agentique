' Fig. 6. – Quatre générations d'intégration, avec pour chacune l'unité intégrée et la forme du contrat qui la décrit.
@startuml
top to bottom direction
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"

rectangle "**Unité intégrée**" as LU #FFFFFF;line:FFFFFF
rectangle "**EAI**\n\n**Le message**" as U1 #EFF6FF;line:2563EB
rectangle "**SOA**\n\n**Le service**" as U2 #EFF6FF;line:2563EB
rectangle "**API**\n\n**La ressource**" as U3 #EFF6FF;line:2563EB
rectangle "**EDA**\n\n**L'événement**" as U4 #EFF6FF;line:2563EB

rectangle "**Forme du contrat**" as LC #FFFFFF;line:FFFFFF
rectangle "Formats et canaux\nconvenus" as C1 #F8FAFC;line:64748B
rectangle "Description de\nservice, politiques" as C2 #F8FAFC;line:64748B
rectangle "Description\nd'interface HTTP" as C3 #F8FAFC;line:64748B
rectangle "Attributs de contexte" as C4 #F8FAFC;line:64748B

LU -[hidden]right-> U1
U1 -[hidden]right-> U2
U2 -[hidden]right-> U3
U3 -[hidden]right-> U4

LC -[hidden]right-> C1
C1 -[hidden]right-> C2
C2 -[hidden]right-> C3
C3 -[hidden]right-> C4

LU -[hidden]down-> LC
U1 -[#94A3B8]down-> C1
U2 -[#94A3B8]down-> C2
U3 -[#94A3B8]down-> C3
U4 -[#94A3B8]down-> C4

rectangle "//Des générations qui se chevauchent : un centre de gravité, pas une succession stricte//" as Note #FFFFFF;line:FFFFFF

C2 -[hidden]down-> Note
C3 -[hidden]down-> Note

@enduml
