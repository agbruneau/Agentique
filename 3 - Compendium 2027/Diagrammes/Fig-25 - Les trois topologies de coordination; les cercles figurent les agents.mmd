%% Fig. 25. – Les trois topologies de coordination; les cercles figurent les agents.
flowchart TB
    subgraph Hier["Hiérarchique"]
        direction TB
        Sup["Superviseur"] --- S1["Superviseur<br/>intermédiaire"]
        Sup --- S2["Superviseur<br/>intermédiaire"]
        S1 --- H1((" "))
        S1 --- H2((" "))
        S2 --- H3((" "))
        S2 --- H4((" "))
        DescH["La centralisation répétée sur<br/>plusieurs niveaux"]
        H1 ~~~ DescH
    end

    subgraph Decent["Décentralisée"]
        direction TB
        D1((" ")) --- D2((" "))
        D2 --- D3((" "))
        D3 --- D4((" "))
        D4 --- D1
        D1 --- D3
        D2 --- D4
        DescD["Échanges directs entre pairs, sans<br/>point de passage obligé"]
        D3 ~~~ DescD
    end

    subgraph Cent["Centralisée"]
        direction TB
        C_A1((" ")) --- Orch["Orchestrateur"]
        C_A2((" ")) --- Orch
        Orch --- C_A3((" "))
        Orch --- C_A4((" "))
        DescC["Les agents ne communiquent qu'avec<br/>l'orchestrateur"]
        C_A3 ~~~ DescC
    end

    style Cent fill:#FFFFFF,stroke:#CBD5E1
    style Decent fill:#FFFFFF,stroke:#CBD5E1
    style Hier fill:#FFFFFF,stroke:#CBD5E1
    style Orch fill:#EFF6FF,stroke:#2563EB
    style Sup fill:#EFF6FF,stroke:#2563EB
    style S1 fill:#EFF6FF,stroke:#2563EB
    style S2 fill:#EFF6FF,stroke:#2563EB
    style DescC fill:transparent,stroke:transparent
    style DescD fill:transparent,stroke:transparent
    style DescH fill:transparent,stroke:transparent
