' Ouvrage : 6 - Livre Blanc
' Figure : Fig. 4 (p. 22)
' Légende : Boucles de dette cognitive, de dette d’intention et de couplage aux modèles

@startuml
title Boucles de dette cognitive, de dette d'intention et de couplage aux modèles

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 38
skinparam ranksep 55
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontColor #0F172A
}
skinparam rectangle {
  BackgroundColor #F1F6F9
  BorderColor #2B4C65
  FontColor #0F172A
  RoundCorner 4
}
skinparam arrow {
  Color #2B4C65
  FontColor #0F172A
}

package "Facteurs de dérive" {
  rectangle "Vélocité générative\nsans assimilation" as F1
  rectangle "Prompts et rustines\nheuristiques (CACE)" as F2
  rectangle "Mises à jour opaques\nfournisseur de modèle" as F3
}

package "Contre-mesures EA / SA" {
  rectangle "Artefacts d'intention\nversionnés" as C1
  rectangle "Abstraction modèle\net contrats typés" as C2
  rectangle "Évaluation continue\net repli L0" as C3
}

package "Triple dette et vulnérabilités" {
  rectangle "Dette cognitive\n(perte du modèle mental)" as D1
  rectangle "Dette d'intention\n(motifs implicites)" as D2
  rectangle "Couplage modèle\n(formats, seuils)" as D3
  rectangle "Consommateurs cachés\net régression silencieuse" as V1
}

F1 --> D1 : Érosion mentale
F2 --> D2 : Logique enfouie
F2 --> D3 : Enchevêtrement
F3 --> D3 : Changement de\ncomportement

C1 --> D2 : Restaure le pourquoi
C2 --> D3 : Découple l'API
C3 --> V1 : Détecte avant prod

D1 --> V1 : Diagnostic impossible
D2 --> V1 : Édition aveugle
D3 --> V1 : Panne à la bascule

@enduml
