@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Parades aux 14 modes d'échec MAST : enveloppe minimale (EXIG-ORC-23..25) et scission B2B DMZ/TEE

package "Z1 — Taxonomie des défaillances (14 modes MAST v3 et 7 frontaliers)" {
  rectangle "① FM-1 conception (44,2 %) · FM-2 désalignement (32,3 %)\nFM-3 vérification (23,5 %)" as N1 <<red>>
  rectangle "7 dérives frontalières : routage erroné,\ndérive HT/TTC, cascade Replit #1152" as N2 <<red>>
  N1 --> N2
}

package "Z2 — Enveloppe de délégation minimale (EXIG-ORC-23..25)" {
  rectangle "② Mandat JSON minimal typé : sous-objectif,\ncritères, URI artefacts, traceparent, plafond" as N3 <<blue>>
  rectangle "Exclusion absolue : zéro historique brut\n& zéro jeton d'accès transmis" as N4 <<blue>>
  N2 --> N3 : Remplace fil complet
  N3 --> N4
}

package "Z3 — Scission B2B Diplomate DMZ / Évaluateur interne et TEE (ADR-026)" {
  rectangle "③ Diplomate A2A en DMZ (≤ 4 tours)\nsans accès aux prix planchers ni marges" as N5 <<amber>>
  rectangle "Évaluateur interne & salle blanche TEE\n(calcul d'utilité confidentiel)" as N6 <<amber>>
  rectangle "④ Filtrage retours + règlement Cedar\n& suite d'injection de fautes CI" as N7 <<blue>>
  N4 --> N5
  N5 --> N6
  N6 --> N7
}

legend bottom
  **Rouge** : Angles morts MAST (spécification floue, boucle de répétition, dérive sémantique)
  **Bleu** : Enveloppe de délégation minimale et contrats typés imputables par rôle
  **Or** : Cloisonnement strict des secrets B2B (Évaluateur interne, TEE et arbitre Cedar)
end legend
@enduml
