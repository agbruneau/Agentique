@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Orchestrateur Saga à point pivot, journal Outbox et canal de compensation isolé EXIG-ORC-28

rectangle "Agent métier probabiliste\n(propose plan, révocable)" as N1 <<prob>>
rectangle "Clé canonique idem-v1 (JCS SHA-256)\nHTTP 409 / 422 divergence" as N2 <<det>>
rectangle "Batterie 10 fautes (EXIG-ORC-20)\n(11/11 tests G0 · test_saga_10_faults.py)" as N3 <<det>>

package "Z1/Z2 — Automate Saga et point pivot P3 (saga_orchestrator.py)" {
  rectangle "Transitions pré-pivot T1 → T2\n(outils de compensation C1, C2 déclarés)" as N4 <<blue>>
  rectangle "Garde pré-pivot (détecte faute T2)" as N5 <<blue>>
  rectangle "Point pivot P3 (PIVOT_REACHED)\nTampon irréversible (bloque repli)" as N6 <<amber>>
  rectangle "Finalisation réessayable T3\n(COMPLETED) ou réconciliation" as N7 <<blue>>
}

package "Z3 — Canal de compensation isolé (EXIG-ORC-28)" {
  rectangle "CompensationChannel dédié\n(NHI & budget propres, immunisé SOC)" as N8 <<green>>
  rectangle "Compensations inverses C2 → C1\n(idempotentes → COMPENSATED)" as N9 <<green>>
  actor "File HUMAN_ESCALATION (ORC-18)\naprès 2 échecs C_k" as N10 <<gray>>
}

database "Transactional Outbox (ajout seul)\n① Persiste T1/C1, T2/C2 avant appel réseau" as N11 <<det>>

N1 .[#D97706].> N4 : Proposition typée
N2 --> N4 : ② Verrouille clé idem-v1
N4 --> N5
N5 --> N6 : ④ Pré-pivot vérifié
N6 --> N7 : Scellement P3
N5 --> N8 : ③ Faute pré-pivot
N3 --> N5 : Fautes 1..9
N3 --> N8 : Faute 10 (agent révoqué)
N8 --> N9 : Exécute C2 → C1
N9 --> N10 : 2 échecs C_k
N4 --> N11
N6 --> N11
N9 --> N11

legend bottom
  **Bleu** : Transitions pré-pivot réversibles T1–T2 et journal préalable Outbox
  **Ambre** : Tampon d'irréversibilité et frontière P3 sans retour arrière possible
  **Vert émeraude** : Canal de compensation isolé EXIG-ORC-28 immunisé contre la coupure SOC
end legend
@enduml
