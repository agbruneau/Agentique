@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.danger {
  BackgroundColor #FEF2F2
  LineColor #B91C1C
  LineThickness 2.0
  FontColor #7F1D1D
}
.ok {
  BackgroundColor #ECFDF5
  LineColor #047857
  LineThickness 2.2
  FontColor #064E3B
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 26
skinparam padding 7

title Le modèle n'est jamais juge et partie : politiques hors modèle OPA/Rego/Cedar au poste PEP
package "Z1 : Zone probabiliste (non fiable pour la sécurité)" {
  rectangle "Modèle LLM substituable\nRaisonnement & invites\n(proscrites comme barrière AP-10)" as LLM <<prob>>
  rectangle "Essaim SRE lecture seule R0\nEnquête sur journaux douteux" as SRE_R0 <<prob>>
}
package "Z2 : Poste-frontière obligé PEP" {
  rectangle "Passerelle agentgateway\nMaillage Zero Trust mTLS\n(« jamais confiance au graphe »)" as PEP <<det>>
  rectangle "Interface AuthZEN 1.0\nInterception 100 % MCP / A2A" as AUTHZ <<det>>
}
package "Z3 : Moteur déterministe PDP hors modèle" {
  rectangle "OPA / Rego v1 (G0 : 45/45)\ndefault allow := false (EXIG-SEC-06)" as OPA <<ok>>
  rectangle "Cedar SMT (< 1,5 ms · cible hors G0)\nforbid prioritaire & entiers 64 bits" as CEDAR <<ext>>
  rectangle "Runbooks bornés SRE R1–R3\nRefroidissement 30 min, 0 shell libre" as RUNBOOK <<det>>
  rectangle "Refus fermé journalisé\nChamp manquant ou shell libre" as DENY <<danger>>
}
LLM .[#B45309].> PEP : ① intention structurée MCP/A2A
SRE_R0 .[#B45309].> PEP : ① demande runbook R1–R3
PEP --> AUTHZ : ② transit mTLS obligé
AUTHZ --> OPA : ③ évaluation déterministe (G0)
AUTHZ --> CEDAR : ③ cible hors G0 (< 1,5 ms)
OPA --> RUNBOOK : autorisé & borné
CEDAR --> RUNBOOK : autorisé & borné
OPA --> DENY : ④ refus par défaut
CEDAR --> DENY : ④ forbid / erreur
legend bottom
  **Ambre probabiliste** : zone cognitive LLM et enquête R0 (propose sans jamais statuer sur ses droits)
  **Bleu acier PEP** : maillage Zero Trust mTLS et passerelle obligatoire agentgateway / AuthZEN
  **Vert déterministe** : moteur OPA/Rego v1 scellé en G0 (default allow := false) · **Gris** : cible Cedar SMT hors G0
end legend
@enduml
