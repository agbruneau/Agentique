@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.danger {
  BackgroundColor #FEF2F2
  LineColor #B91C1C
  LineThickness 2.0
  FontColor #7F1D1D
}
.ok {
  BackgroundColor #ECFDF5
  LineColor #047857
  LineThickness 2.2
  FontColor #064E3B
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 26
skinparam padding 7

title Coupe-circuits hiérarchisés, révocation SSF/CAEP et repli < 60 s sans briser les sagas
package "Z1 : Détection AISPM/AIDR et automate à 5 états" {
  rectangle "Sonde AISPM / AIDR & FinOps\nEmballement ASI08/10, GTG-1002" as DET <<prob>>
  rectangle "Automate coupe-circuit\nCLOSED → OPEN → FORCED_OPEN" as FSM <<det>>
}
package "Z2 : Coupure 4 paliers et révocation SSF/CAEP" {
  rectangle "Passerelle PEP (POR-003)\nBlocage voie avant < 10 s (0,050 ms local)" as PEP <<danger>>
  rectangle "SOAR & OpenID SSF/CAEP\nÉviction SPIRE & OAuth ≤ 15 min (CAD26)\nIdentité SOC propre (hors PIM/TAP F-57)" as SOAR <<danger>>
  rectangle "Rétrogradation autonomie\nRepli vers N2/L0 < 60 s (POR-015)" as REPLI <<prob>>
}
package "Z3 : Sanctuaire de reprise Saga & forensique" {
  database "Gel forensique Temporal\nMicroVM & journaux préservés" as GEL <<det>>
  rectangle "Canal de compensation Saga\nEXIG-ORC-28 maintenu ouvert\nAnnulation propre en cours" as SAGA <<ok>>
}
DET .[#B45309].> FSM : ① anomalie / budget épuisé
FSM --> PEP : ② bascule FORCED_OPEN
PEP --> SOAR : ③ propage révocation
FSM --> REPLI : repli < 60 s
PEP --> GEL : fige file & artefacts
PEP --> SAGA : ④ canal isolé préservé
legend bottom
  **Rouge urgence** : coupure voie avant (FORCED_OPEN, POR-003 < 10 s, SSF/CAEP ≤ 15 min)
  **Ambre repli** : détection et rétrogradation vers flux déterministe N2/L0 (< 60 s POR-015)
  **Bleu/Vert compensation** : canal de compensation Saga EXIG-ORC-28 et preuves préservées
end legend
@enduml
