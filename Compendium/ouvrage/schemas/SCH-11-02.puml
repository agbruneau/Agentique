@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Mémoire bi-temporelle (BSIF E-23), concurrence multi-agents et effacement crypto-sélectif (Loi 25 art. 23)

package "Z1 — Contrôle d'écriture et signature HMAC (Letta / écrivain unique)" {
  rectangle "① Point écrivain unique & verrou optimiste\n(résolution des conflits inter-agents)" as N1 <<det>>
  rectangle "Étiquette de provenance HMAC anti-ASI06\n& quarantaine des faits contestés" as N2 <<amber>>
  N1 --> N2
}

package "Z2 — Double ligne temporelle Graphiti (audit BSIF E-23 / §39.5)" {
  database "Arêtes bi-temporelles\n(valid_from / valid_to + system_time)" as N3 <<det>>
  rectangle "② Supersession temporelle sans effacement\n(reconstitution exacte à toute date passée)" as N4 <<det>>
  N2 --> N3 : Ouvre arête datée
  N3 --> N4
}

package "Z3 — Purge sélective vérifiable (Loi 25 art. 23 et RGPD art. 17)" {
  rectangle "③ Révocation clé dédiée (Crypto-Shredding)\n& invalidation en cascade des faits dérivés" as N5 <<purple>>
  rectangle "④ Garde de lecture : vérification portée\n& validité temporelle (exclut souvenirs révoqués)" as N6 <<purple>>
  N3 --> N5 : Demande d'oubli / rectification
  N5 --> N6 : Préserve structure du graphe
}

legend bottom
  **Bleu ardoise** : Double horodatage bi-temporel et écrivain unique (BSIF E-23)
  **Violet** : Effacement crypto-sélectif vérifiable (Loi 25 art. 23, RGPD art. 17)
  **Ambre** : Quarantaine et signature HMAC contre l'empoisonnement mémoriel (ASI06)
end legend
@enduml
