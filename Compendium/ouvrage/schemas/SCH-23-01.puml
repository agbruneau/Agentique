@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.danger {
  BackgroundColor #FEF2F2
  LineColor #B91C1C
  LineThickness 2.0
  FontColor #7F1D1D
}
.ok {
  BackgroundColor #ECFDF5
  LineColor #047857
  LineThickness 2.2
  FontColor #064E3B
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 26
skinparam padding 7

title Banc EvalOps hermétique E1–E3, constance pass^k et borne de Wilson (≥ 300 essais)
package "Z1 : Étages E1 (CI) et E2 (Arène hermétique)" {
  rectangle "Déclencheur EXIG-GOV-12\nManifeste SemVer+Intent (0 latest)" as TRIG <<det>>
  rectangle "Étage E1 : Contrats CI\nSchémas MCP, Rego, fautes Saga" as E1 <<det>>
  rectangle "Étage E2 : Banc hermétique\nAgent évalué vs MockMcpServer\nChaos HTTP 429, 0 SoR réel" as E2 <<prob>>
  rectangle "Constance pass^k (k ≥ 3 ; k ≥ 5 critique)\n& Wilson 95 % < p (n ≥ 300 → 0,8938 %)" as WIL <<ok>>
}
package "Z2 : Bancs publics et promotion canari" {
  rectangle "Distribution complète\nSWE-bench, τ-bench, TCK A2A\n& déploiement fantôme → canari" as CAN <<det>>
}
package "Z3 : Étage E3 (Production) et rétrogradation" {
  rectangle "Étage E3 : Production continue\n5–10 % trafic + 100 % anomalies (30 j)" as E3 <<det>>
  rectangle "Rétrogradation automatique\nPOR-015 (< 60 s) & recul après\n3 mois hors SLO (EXIG-EVA-06)" as RETR <<danger>>
}
TRIG --> E1 : ① à chaque changement
E1 --> E2 : contrats valides
E2 .[#B45309].> WIL : ② ≥ 300 cas indépendants
WIL --> CAN : ③ promotion immuable
CAN --> E3 : trafic réel surveillé
E3 --> RETR : ④ budget d'erreur épuisé
legend bottom
  **Bleu CI / Vert statistique** : étages E1–E2 hermétiques, constance pass^k et borne de Wilson (n ≥ ceil(3/p))
  **Ambre probabiliste** : agent évalué sur doublures MockMcpServer sans accès réseau
  **Rouge rétrogradation** : abaissement automatique d'autonomie après 3 mois hors SLO
end legend
@enduml
