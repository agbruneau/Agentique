@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.danger {
  BackgroundColor #FEF2F2
  LineColor #B91C1C
  LineThickness 2.0
  FontColor #7F1D1D
}
.ok {
  BackgroundColor #ECFDF5
  LineColor #047857
  LineThickness 2.2
  FontColor #064E3B
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 26
skinparam padding 7

title Boucle d'érosion cognitive : comment l'automatisation fragilise la relève et le repli manuel
package "Z1 : Boucle d'érosion silencieuse (E1 → E5)" {
  rectangle "E1. Automatisation 1er niveau\nGains +26 % à +40 %" as E1 <<prob>>
  rectangle "E2. Contraction relève junior\n-20 % (22–25 ans Stanford) · 18 % frein" as E2 <<ext>>
  rectangle "E3. Approbation réflexe\nÉmoussement du jugement clinique" as E3 <<ext>>
  rectangle "E4. Atrophie du savoir-faire\nPerte de mémoire transactive" as E4 <<ext>>
  rectangle "E5. Échec du repli manuel\nIncapacité sous crise B-10 / E-21" as E5 <<danger>>
}
package "Z2 : Trois disjoncteurs possédés (D1, D2 et D3)" {
  rectangle "D1 : Couloir lecture seule\n& propriétaire unique" as D1 <<det>>
  rectangle "D2 : Ergonomie anti-complaisance\n& cas témoins à l'aveugle" as D2 <<det>>
  rectangle "D3 : Quotas formateurs manuels\n& exercices sans agent" as D3 <<ok>>
}
E1 -right-> E2 : ① tarit pratique
E2 -right-> E3 : raréfie relève
E3 -down-> E4 : ② efface réflexes
E4 -left-> E5 : ③ expose en panne
E5 .[#B45309]up.> E1 : pousse à automatiser
D1 -up-> E1 : ④ borne accès
D2 -up-> E3 : ④ mesure vigilance
D3 -up-> E4 : ④ préserve relève & repli
legend bottom
  **Ambre pointillé** : automatisation initiale E1 masquant la dette cognitive
  **Gris / Rouge** : enchaînement E2 → E5 menant à l'échec du repli manuel
  **Bleu / Vert** : trois disjoncteurs organisationnels possédés D1, D2 et D3
end legend
@enduml
