@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Filtrage RBAC/ABAC pré-récupération (OpenFGA/RLS), modèles Silo/Bridge/Pool et évaluation RAG

package "Z1 — Filtre d'habilitation pré-récupération (EXIG contre OWASP LLM08)" {
  rectangle "① Requête + jeton d'identité déléguée\ndu mandant effectif" as N1 <<det>>
  rectangle "Moteur OpenFGA / PostgreSQL RLS (ABAC)\nFiltre AVANT tout calcul de similarité" as N2 <<det>>
  rectangle "Anti-patron proscrit : post-filtrage tardif\n(risque de fuite vectorielle LLM08:2025)" as N3 <<red>>
  N1 --> N2
  N2 .[#B91C1C].> N3 : Exclu
}

package "Z2 — Trois architectures d'isolation multi-locataires" {
  database "② Modèle Silo : isolation physique\n(données sensibles / par filiale)" as N4 <<green>>
  database "Modèle Bridge : partition logique\n(Qdrant / pgvector RLS)" as N5 <<green>>
  database "Modèle Pool : documents publics\nexclusivement" as N6 <<det>>
  N2 --> N4
  N2 --> N5
  N2 --> N6
}

package "Z3 — Ancrage vérifiable et évaluation RAG dissociée" {
  rectangle "③ Génération à citations énoncé par énoncé\n+ abstention si preuve manquante" as N7 <<green>>
  rectangle "④ Banc CI dissocié : Recall@K (recherche)\npar rapport à RAGAS / ARES / CRAG (génération)" as N8 <<det>>
  N4 --> N7
  N5 --> N7
  N7 --> N8
}

legend bottom
  **Bleu ardoise** : Évaluation des droits pré-récupération (OpenFGA, RLS, RBAC/ABAC)
  **Vert émeraude** : Cloisonnement Silo/Bridge et citation vérifiable énoncé par énoncé
  **Rouge** : Fuite vectorielle OWASP LLM08:2025 par index Pool non filtré ou post-filtrage
end legend
@enduml
