@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title De l'essai ponctuel (pass@1) à la constance industrielle (pass^k ≥ 0,95 et Wilson 95 %)

package "Z1 — Illusion du potentiel (pass@k) et palmarès biaisés" {
  rectangle "Métrique pass@k (≥ 1 succès sur k)\nDissimule l'effondrement (< 25 % à pass^8)" as N1 <<red>>
  rectangle "Palmarès publics contaminés\n(> 25 % biaisés : HAL, SWE-bench)" as N2 <<red>>
  N1 .[#DC2626].> N2 : ① Exclure en production
}

package "Z2 — Exigence de constance (pass^k = p^k) et courbe HAL" {
  rectangle "Banc hermétique τ-bench\n(sans appel réel aux SoR)" as N3 <<teal>>
  rectangle "Exécution répétée EXIG-EVA-03\n(k = 3 minimal · k = 5 critique ≥ 0,95–0,99)" as N4 <<teal>>
  rectangle "Arbitrage coût / précision\nsur la courbe HAL (ADR-022)" as N5 <<teal>>
  N2 --> N3 : ② Isoler scénarios
  N3 --> N4
  N4 --> N5
}

package "Z3 — Porte statistique CI/CD et borne de Wilson à 95 %" {
  rectangle "Calcul Wilson (evalops_prr/wilson_bounds.py)\nn ≥ ceil(3/p) sur ≥ 50 à 100 scénarios" as N6 <<indigo>>
  rectangle "Porte bloquante C31 / PRR F-15\n& veille de dérive METR" as N7 <<indigo>>
  N5 --> N6 : ③ Attester constance
  N6 --> N7 : ④ Bloquer si pass^5 < seuil
}

legend bottom
  **Corail alerte** : Métrique trompeuse pass@k et palmarès contaminés impropres à la production
  **Turquoise** : Constance multi-essais pass^k, banc hermétique et borne de Wilson à 95 %
  **Indigo** : Porte CI/CD bloquante C31 / PRR F-15 autorisant la promotion
end legend
@enduml
