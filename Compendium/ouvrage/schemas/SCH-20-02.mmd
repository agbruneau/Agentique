%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'DejaVu Sans', 'fontSize': '13px', 'lineColor': '#334155', 'edgeLabelBackground': '#FFFFFF', 'primaryTextColor': '#0F2942'}, 'flowchart': {'nodeSpacing': 22, 'rankSpacing': 30, 'padding': 18, 'subGraphTitleMargin': {'top': 8, 'bottom': 14}}}}%%
flowchart TD
  subgraph Z1["Z1 : Illusion probabiliste"]
    PROB["Filtre IA ou juge LLM<br/>auxiliaire isolé"]:::prob
    ADAPT{"Attaquant adaptatif<br/>(joue en second) ?"}:::danger
    CEDE["Contournement & comportements<br/>déviants (METR / AgentHarm)"]:::danger
  end
  subgraph Z2["Z2 : Analyse systémique STAMP/STPA"]
    STPA["① Recensement STPA des actions<br/>de contrôle dangereuses"]:::det
    BANC["② Épreuve sur bancs adversariaux<br/>AgentDojo, InjecAgent, AgentHarm"]:::det
  end
  subgraph Z3["Z3 : Sortie normative déterministe"]
    CONV["③–④ Conversion en verrous<br/>hors modèle OPA / Cedar"]:::ok
    DISJ["Disjoncteurs & retrait<br/>non dérogeable d'outils"]:::ok
  end
  PROB -.-> ADAPT
  ADAPT -->|Sans verrou hors modèle| CEDE
  STPA --> BANC
  BANC -.->|Échec filtre IA| CEDE
  CEDE -->|Convertir chaque boucle| CONV
  BANC -->|Spécifie bornes| CONV --> DISJ

  classDef det fill:#EBF2F7,stroke:#1E4E79,stroke-width:2.5px,color:#0F2942
  classDef prob fill:#FFF5E0,stroke:#B45309,stroke-width:2px,stroke-dasharray:6 4,color:#451A03
  classDef danger fill:#FEF2F2,stroke:#B91C1C,stroke-width:2.2px,color:#7F1D1D
  classDef ok fill:#ECFDF5,stroke:#047857,stroke-width:2.2px,color:#064E3B
  classDef ext fill:#F3F4F6,stroke:#4B5563,stroke-width:1.5px,color:#111827
  style Z1 fill:#FFF1F2,stroke:#E11D48,stroke-width:1.2px
  style Z2 fill:#F8FAFC,stroke:#0369A1,stroke-width:1.2px
  style Z3 fill:#ECFDF5,stroke:#15803D,stroke-width:1.2px
