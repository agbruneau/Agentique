@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Traduction réglementaire (§ 29.4.1), contrôleur OO3/OO4 et choix de boucle mono-agent

package "Z1 — Test cumulatif § 29.4.1 et Tableau 29.1" {
  rectangle "11 entrées réglementaires\n(BSIF E-23, Loi 25 art. 12.1, ACVM 11-348)" as N1 <<blue>>
  rectangle "Test à 3 conditions : issue opposable +\ntrace tierce + dommage non réparable" as N2 <<blue>>
  rectangle "9 contraintes de cadre (OO3/OO4)\n(seul artefact démontrable)" as N3 <<blue>>
  N1 --> N2 : ① Qualifier contrainte
  N2 --> N3 : ② Commande en OO3/OO4
}

package "Z2 — Séparation contrôleur / exécuteur et 5 horloges" {
  rectangle "Contrôleur déterministe (code pur)\nÉvite « agentivité non justifiée » et « plan rigide »" as N4 <<det>>
  rectangle "Synchronisation des 5 horloges\n(modèle, invites, outils, politiques, harnais)" as N5 <<det>>
  N3 --> N4 : ③ Code pour étapes prévisibles
  N4 --> N5 : ④ Verrouiller 5 horloges
}

package "Z3 — Sélection des boucles mono-agent bornées" {
  rectangle "ReAct & Reflexion borné\n(contre chambre d'écho)" as N6 <<prob>>
  rectangle "ReWOO / LLMCompiler\n(parallélisation sans surcoût)" as N7 <<prob>>
  rectangle "CodeAct en microVM/WASI sans réseau\n& Set-of-Mark en dernier recours GUI" as N8 <<prob>>
  N4 .[#D97706].> N6
  N4 .[#D97706].> N7
  N4 .[#D97706].> N8
}

legend bottom
  **Bleu conformité** : Test § 29.4.1 et 9 contraintes (BSIF E-23, Loi 25, ACVM 11-348)
  **Bleu ardoise** : Contrôleur déterministe OO3/OO4 et 5 horloges de versionnage
  **Ambre pointillé** : Boucle mono-agent bornée (CodeAct isolé en microVM, ReWOO)
end legend
@enduml
