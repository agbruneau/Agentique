@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Architecture des quatre mémoires CoALA isolées (zéro écriture partagée) et échelle de risque

rectangle "Agent lecteur / rédacteur\n(① Inter-sessions fermé par défaut PRIN-11)" as N1 <<prob>>
rectangle "Filtre ACL amont & sas de validation\n(② Signature HMAC anti-ASI06 · zéro partage écriture)" as N2 <<det>>

package "Quatre compartiments CoALA isolés" {
  rectangle "Z1 · Mémoire de travail (risque minimal)\nSession éphémère chiffrée hors processus" as N3 <<det>>
  database "Z2 · Mémoire épisodique\nRésumés typés + TTL · marqués non fiables" as N4 <<amber>>
  database "Z3 · Mémoire sémantique\nGraphes/index ACL · jamais source d'authZ P2/P3" as N5 <<amber>>
  database "Z4 · Mémoire procédurale (risque maximal)\nInvites & Agent Skills signés · figés PC4" as N6 <<red>>
}

rectangle "Moteur d'indexation vectoriel\n& rappel filtré" as N7 <<det>>
rectangle "Moteur de purge légale (Loi 25)\n& contrôle de changement logiciel" as N8 <<det>>

N1 --> N2 : ③ Requête typée + mandat
N2 --> N3 : État tâche courante
N2 --> N7 : Périmètre ACL permis
N7 --> N4 : Rappel filtré non fiable
N7 --> N5 : Lecture seule expirante
N1 .[#D97706].> N2 : Écriture proposée
N2 --> N4 : Schéma validé + HMAC
N8 --> N4 : Purge planifiée
N8 --> N6 : ④ Verrouillé hors prod. (PC4)

legend bottom
  **Bleu ardoise** : Compartiment de travail hors processus chiffré et garde EXIG-ARC-25
  **Ambre** : Mémoires épisodique et sémantique (lecture filtrée ACL, écriture schématisée)
  **Rouge** : Mémoire procédurale critique verrouillée contre toute auto-modification (PC4)
end legend
@enduml
