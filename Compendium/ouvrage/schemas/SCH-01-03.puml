@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Tamiser la preuve : filtre PRISMA-ScR W3.2, pyramide à 6 niveaux et LLM-Modulo

package "Z1 — Entonnoir scientifique PRISMA-ScR / Garousi (lot W3.2)" {
  rectangle "582 notices initiales\n(5 sources ouvertes, 3 en statut F)" as N1 <<blue>>
  rectangle "453 dédupliquées (AACODS 9,97/12)\n→ 223 textes intégraux SHA-256" as N2 <<blue>>
  rectangle "160 études incluses\n(κ = 0,7935 · 0 % sur résumé seul)" as N3 <<blue>>
  N1 --> N2 : ① Tri sans contournement
  N2 --> N3 : Lecture intégrale
}

package "Z2 — Pyramide probante à six niveaux (études de cas)" {
  rectangle "Niveau 1 : Production arbitrée (Nubank KDD 2026)\nNiveau 2 : Enquête MAP" as N4 <<green>>
  rectangle "Niveaux 3–4 : Éditeurs & bancs (SEC, ITBench, ORCA)\nNiveaux 5–6 : Registre MCN (432) & déclaratif" as N5 <<det>>
  N3 --> N4 : ② Classement probatoire
  N4 --> N5
}

package "Z3 — Planification et vérificateur externe LLM-Modulo" {
  rectangle "Calcul étendu à l'inférence\n(ToT, LATS, PlanBench)" as N6 <<prob>>
  rectangle "Trace Chain-of-Thought\n(infidèle : non opposable)" as N7 <<amber>>
  rectangle "Vérificateur formel externe\nLLM-Modulo / LLM+P (valide ou rejette)" as N8 <<green>>
  N5 --> N6 : ③ Propose plans candidats
  N6 .[#D97706].> N7
  N6 .[#D97706].> N8 : ④ Vérification mécanique
}

legend bottom
  **Bleu marine** : Corpus scientifique vérifié sur texte intégral SHA-256 (160 études W3.2)
  **Ambre pointillé** : Propositions de planification probabiliste et traces CoT non opposables
  **Vert émeraude** : Vérificateur formel externe LLM-Modulo autorisant ou rejetant le plan
end legend
@enduml
