@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Attestations éphémères SPIFFE/SPIRE (1 h) en interne et trajectoire vLEI / passeport B2B

package "Z1 — Socle interne immédiat : Attestation SPIFFE/SPIRE et veille WIMSE" {
  rectangle "Attestation nœud & charge\n(TPM 2.0, kubelet, condensat OCI)" as N1 <<green>>
  rectangle "SPIRE Server / Agent & Envoy SDS\nX.509-SVID éphémère 1 h (préféré au JWT 15 min)" as N2 <<green>>
  rectangle "Isolation hors production / production (IEC 62443 SL-3)\nRotation Edge 72 h · adaptateurs WIMSE" as N3 <<green>>
  N1 --> N2 : ① Injection en mémoire (0 disque)
  N2 --> N3 : ② Domaines isolés
}

package "Z2 — Architecture cible B2B : Passeport d'agent virtuel à 4 (+1) pièces" {
  rectangle "AgentCard signée + registre + mandat +\nattestations (+1 AIBOM provenance)" as N4 <<blue>>
  rectangle "③ 4 substituts provisoires internes\n(conformité BSIF E-23 / AMF 1er mai 2027)" as N5 <<blue>>
  N3 --> N4
  N4 --> N5
}

package "Z3 — Ancrage légal Palier 3 : GLEIF vLEI (ISO 17442-3) et W3C VC 2.0" {
  rectangle "④ Chaîne légale QVI → LE → OOR/ECR\n& W3C VC 2.0 / DID (CAP-006/041)" as N6 <<amber>>
  rectangle "Activation conditionnelle Palier 3\nsur signaux SIG-007 et SIG-103 (zéro grattage)" as N7 <<amber>>
  N5 .[#B45309].> N6 : Signaux SIG-007/103
  N6 --> N7
}

legend bottom
  **Vert émeraude** : Socle SPIFFE/SPIRE X.509-SVID opérationnel en interne sans secret fixe
  **Bleu** : Substituts provisoires du passeport d'agent et adaptateurs WIMSE réversibles
  **Or ambré** : Fédération externe GLEIF vLEI / W3C VC 2.0 activée au Palier 3 sur signaux SIG
end legend
@enduml
