{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalopsWilsonReport",
  "x-license": "MIT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id", "evaluated_at", "target_max_failure_p",
    "n_independent", "successes", "failures", "min_required_trials",
    "wilson_failure_upper_95", "passes_gate", "scenario_ids", "reason"
  ],
  "properties": {
    "report_id": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 10 },
    "target_max_failure_p": {
      "type": "number", "exclusiveMinimum": 0, "maximum": 1
    },
    "n_independent": { "type": "integer", "minimum": 1 },
    "successes": { "type": "integer", "minimum": 0 },
    "failures": { "type": "integer", "minimum": 0 },
    "min_required_trials": { "type": "integer", "minimum": 1 },
    "wilson_failure_upper_95": {
      "type": "number", "minimum": 0, "maximum": 1
    },
    "passes_gate": { "type": "boolean" },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reason": { "type": "string" }
  }
}
