{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2AAgentCard",
  "x-license": "MIT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name", "description", "supportedInterfaces", "provider", "version",
    "capabilities", "securitySchemes", "securityRequirements",
    "defaultInputModes", "defaultOutputModes", "skills", "signatures"
  ],
  "$defs": {
    "SecurityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemes"],
      "properties": {
        "schemes": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9_.-]+$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["list"],
              "properties": {
                "list": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "OidcScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openIdConnectSecurityScheme"],
      "properties": {
        "openIdConnectSecurityScheme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openIdConnectUrl"],
          "properties": {
            "openIdConnectUrl": { "type": "string", "pattern": "^https://" }
          }
        }
      }
    },
    "MutualTlsScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutualTlsSecurityScheme"],
      "properties": {
        "mutualTlsSecurityScheme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": { "description": { "type": "string" } }
        }
      }
    },
    "OAuth2Scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oauth2SecurityScheme"],
      "properties": {
        "oauth2SecurityScheme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flows"],
          "properties": {
            "flows": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^(authorizationCode|clientCredentials|deviceCode)$": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tokenUrl"],
                  "properties": {
                    "tokenUrl": { "type": "string", "pattern": "^https://" }
                  },
                  "patternProperties": {
                    "^(authorizationUrl|deviceAuthorizationUrl|refreshUrl)$": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "^pkceRequired$": { "type": "boolean" },
                    "^scopes$": {
                      "type": "object",
                      "additionalProperties": false,
                      "patternProperties": {
                        "^[a-zA-Z0-9_.:-]+$": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "supportedInterfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "protocolBinding", "protocolVersion"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "protocolBinding": {
            "type": "string", "enum": ["JSONRPC", "GRPC", "HTTP+JSON"]
          },
          "protocolVersion": { "type": "string", "pattern": "^1\\.\\d+$" }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "url"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streaming", "pushNotifications", "extendedAgentCard", "extensions"
      ],
      "properties": {
        "streaming": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" },
        "extendedAgentCard": { "type": "boolean" },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "description", "required", "params"],
            "properties": {
              "uri": { "type": "string", "pattern": "^https://" },
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^[a-zA-Z0-9_.-]+$": {
                    "type": ["string", "number", "boolean"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9_.-]+$": {
          "oneOf": [
            { "$ref": "#/$defs/OidcScheme" },
            { "$ref": "#/$defs/MutualTlsScheme" },
            { "$ref": "#/$defs/OAuth2Scheme" }
          ]
        }
      }
    },
    "securityRequirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SecurityRequirement" }
    },
    "defaultInputModes": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "defaultOutputModes": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "description", "tags",
          "examples", "securityRequirements"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "securityRequirements": {
            "type": "array",
            "items": { "$ref": "#/$defs/SecurityRequirement" }
          }
        },
        "patternProperties": {
          "^(inputModes|outputModes)$": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protected", "signature"],
        "properties": {
          "protected": { "type": "string", "minLength": 10 },
          "signature": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
