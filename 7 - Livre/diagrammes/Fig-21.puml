@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 30
skinparam padding 9

package "Socle sans regret (2027–2029)" {
  rectangle "2027 : Noyau sans regret\n(80/20, NHI, journal)" as S27 <<det>>
  rectangle "2027–2029 : Collision PKI\n(TLS 100 j → 47 j mars 2029)" as PKI <<det>>
  rectangle "Agilité cryptographique sans regret\n(ACME, ML-KEM hybride, gabarit PQC)" as AGIL <<det>>
  rectangle "Capteurs de signaux\net portes budgétaires DAPP" as SIG <<det>>
}

rectangle "2030–2035 : Bascule PQC conditionnelle\n(signatures ML-DSA ~52–72× sur seuils)" as PQC <<det>>

package "Bifurcations (2028–2035)" {
  rectangle "Scénario A : Socle ouvert\nétendu (SCITT / standards ouverts)" as SA <<ext>>
  rectangle "Scénario B : Archipel\nde suites fermées" as SB <<ext>>
  rectangle "Scénario C : Blocs\nsouverains isolés" as SC <<ext>>
  rectangle "Option A : Fédérations\nouvertes vérifiables" as OA <<det>>
  rectangle "Option B : Couches\nd'extraction multi-modèles" as OB <<det>>
  rectangle "Option C : Inférence\nlocale souveraine" as OC <<det>>
}

rectangle "Horizon 2035 : Achèvement PQC G7 et autonomie gouvernée" as H35 <<det>>

S27 -right-> PKI
PKI -right-> AGIL : automatisation
S27 --> SIG : veille budgétée
AGIL --> PQC : préparation sans regret
SIG ..> PQC : déclenchement
SIG ..> SA
SIG ..> SB
SIG ..> SC
SA --> OA
SB --> OB
SC --> OC
OA --> H35
OB --> H35
OC --> H35
PQC --> H35

AGIL -[hidden]down-> SIG
SA -[hidden]right-> SB
SB -[hidden]right-> SC
OA -[hidden]right-> OB
OB -[hidden]right-> OC

legend bottom
  **Trait plein ardoise** : socle ou option déterministe possédée
  **Trait plein gris** : scénario externe sans probabilité
end legend
@enduml
