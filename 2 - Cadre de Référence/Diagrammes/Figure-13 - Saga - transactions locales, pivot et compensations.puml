' Figure 13 — Saga : transactions locales, pivot et compensations (2 - Cadre de Référence, ch. 7, p. 109)
' Source : cadre CRE-IA-2026-01, d'après Garcia-Molina et Salem (1987), Microsoft et Temporal
@startuml
top to bottom direction
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam defaultTextAlignment center
skinparam ranksep 34
skinparam nodesep 20

package "TRANSACTIONS LOCALES (VERS L’AVANT)" as Trans #FFFFFF;line:FFFFFF {
  rectangle "**<color:#0F7682>T1 (OK)</color>**\nRéserver le transport\ncompensable" as T1 #E2F4F0;line:0F7682
  rectangle "**<color:#0F7682>T2 (OK)</color>**\nRéserver le stock (ERP)\ncompensable" as T2 #E2F4F0;line:0F7682
  rectangle "**<color:#9C2F39>T3 — échec</color>**\nPréautoriser le paiement\ncompensable (P2)" as T3 #FCE8EB;line:9C2F39
  rectangle "**<color:#64748B>T4 · pivot</color>**\nConfirmation officielle\nirréversible · approbation" as T4 #F1F5F9;line:94A3B8;line.dashed

  T1 -right-> T2
  T2 -right-> T3
  T3 .right. T4
}

package "COMPENSATIONS\n(ORDRE INVERSE, IDEMPOTENTES)" as Comp #FFFFFF;line:FFFFFF {
  rectangle "**<color:#B45309>C1</color>**\nAnnuler la réservation" as C1 #FEF3DC;line:B45309
  rectangle "**<color:#B45309>C2</color>**\nLibérer le stock" as C2 #FEF3DC;line:B45309
  rectangle "**2 échecs d’une compensation**\n→ file humaine prioritaire" as Esc #FFFFFF;line:9C2F39;line.dashed

  C2 -[#B45309]left-> C1
  C2 -[hidden]right-> Esc
}

T3 -[#9C2F39,thickness=2]down-> C2 : <color:#9C2F39>échec définitif → compenser de k−1 à 1</color>

package "JOURNAL EN AJOUT SEUL (LA COMPENSATION EST JOURNALISÉE AVANT L’ACTION)" as Journal #F8FAFC;line:CBD5E1 {
  rectangle "1. journaliser\nC1" as J1 #FFFFFF;line:CBD5E1
  rectangle "2. exécuter\nT1 (OK)" as J2 #FFFFFF;line:0F7682
  rectangle "3. journaliser\nC2" as J3 #FFFFFF;line:CBD5E1
  rectangle "4. exécuter\nT2 (OK)" as J4 #FFFFFF;line:0F7682
  rectangle "5. journaliser\nC3" as J5 #FFFFFF;line:CBD5E1
  rectangle "6. T3\néchoue" as J6 #FFFFFF;line:9C2F39
  rectangle "7. exécuter\nC2" as J7 #FFFFFF;line:B45309
  rectangle "8. exécuter\nC1" as J8 #FFFFFF;line:B45309

  J1 -[hidden]right-> J2
  J2 -[hidden]right-> J3
  J3 -[hidden]right-> J4
  J4 -[hidden]right-> J5
  J5 -[hidden]right-> J6
  J6 -[hidden]right-> J7
  J7 -[hidden]right-> J8
}

T1 -[hidden]down-> C1
T2 -[hidden]down-> C2
C1 -[hidden]down-> J1
C2 -[hidden]down-> J3
Esc -[hidden]down-> J6

legend bottom
  T3 n’a jamais été marquée « terminée » : C3 n’est exécutée que si l’issue de T3, une fois résolue, est un effet réalisé (EXIG-ORC-16). Le pivot T4 n’est atteint qu’après succès de T1 à T3.
endlegend
@enduml
