%% Figure 25 — Cycle de vie d'un agent et jalons (2 - Cadre de Référence, ch. 11, p. 199)
%% Source : cadre CRE-IA-2026-01
flowchart TB
    subgraph Etapes["ÉTAPES"]
        direction LR
        E1["<b>1 · Proposition</b><br/>Cas d’usage, valeur<br/>attendue, propriétaire<br/>métier nommé"]
        E2["<b>2 · Conception</b><br/>Classe de risque, niveau<br/>d’autonomie, patron,<br/>contrats, EFVP"]
        E3["<b>3 · Construction</b><br/>Gabarits de plateforme,<br/>jeu de référence,<br/>tests de sécurité"]
        E4["<b>4 · Pilote</b><br/>Périmètre et durée<br/>bornés, du niveau<br/>inférieur au visé"]
        E5["<b>5 · Production</b><br/>Surveillance, évaluation<br/>continue, gestion<br/>des changements"]
        E6["<b>6 · Retrait</b><br/>Révocation des identités,<br/>retrait du catalogue,<br/>archivage, avis"]
        E1 --> E2 --> E3 --> E4 --> E5 --> E6
    end

    subgraph Jalons["JALONS DU CYCLE DE VIE"]
        direction LR
        J1{"<b>Fiche au registre</b><br/>état « proposé »"}
        J2{"<b>Revue d’architecture</b><br/>et de sécurité"}
        J3{"<b>Seuils d’évaluation</b><br/>atteints"}
        J4{"<b>Homologation</b><br/>(annexe A)"}
        J5{"<b>Attestation périodique</b><br/>(12 mois; 6 si élevé)"}
        J6{"<b>Preuve de</b><br/>révocation"}
        J1 ~~~ J2 ~~~ J3 ~~~ J4 ~~~ J5 ~~~ J6
        J5 -.->|"Changement de modèle, d’invite, d’outil, de protocole ou de population visée → réévaluation"| J2
    end

    Etapes ~~~ Jalons

