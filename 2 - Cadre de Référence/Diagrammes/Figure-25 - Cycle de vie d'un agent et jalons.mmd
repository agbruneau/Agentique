    classDef s2 fill:#165b7a,stroke:#165b7a,color:#ffffff
    classDef s3 fill:#0f7682,stroke:#0f7682,color:#ffffff
    classDef s4 fill:#28774e,stroke:#28774e,color:#ffffff
    classDef s5 fill:#0f2744,stroke:#0f2744,color:#ffffff
    classDef s6 fill:#475569,stroke:#475569,color:#ffffff
    classDef jalon fill:#fef3dc,stroke:#b45309,stroke-width:2px,color:#0f2744
