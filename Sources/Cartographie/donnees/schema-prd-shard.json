{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentique.local/schemas/schema-prd-shard.json",
  "schema_version": "1.0.0",
  "lang": "fr-CA",
  "title": "Schéma formel des shards de rédaction du PRD maître (Corpus Agentique)",
  "description": "Définit les contrats JSON stricts pour le shard de cadrage maître (prd-global-et-annexes.json) et les six shards de domaines (prd-d01-d02.json à prd-d11-d12.json) alimentant Sources/Cartographie/outils/compiler_prd.py vers Sources/Compendium/prd.md.",
  "prd_metrics_target": {
    "domains_count": 12,
    "chapters_count": 36,
    "families_count": 71,
    "themes_count": 260,
    "relations_count": 616,
    "annexes_count": 5,
    "executive_summary_sections_count": 5,
    "chapter_formula": "chapter_number = (int(domain_id[1:]) - 1) * 3 + int(subdomain_node_id.split('_')[-1])",
    "domain_chapter_distribution": {
      "prd-d01-d02": { "domains": ["D01", "D02"], "chapters": [1, 2, 3, 4, 5, 6], "families": 12, "themes": 43 },
      "prd-d03-d04": { "domains": ["D03", "D04"], "chapters": [7, 8, 9, 10, 11, 12], "families": 12, "themes": 44 },
      "prd-d05-d06": { "domains": ["D05", "D06"], "chapters": [13, 14, 15, 16, 17, 18], "families": 12, "themes": 39 },
      "prd-d07-d08": { "domains": ["D07", "D08"], "chapters": [19, 20, 21, 22, 23, 24], "families": 12, "themes": 40 },
      "prd-d09-d10": { "domains": ["D09", "D10"], "chapters": [25, 26, 27, 28, 29, 30], "families": 12, "themes": 47 },
      "prd-d11-d12": { "domains": ["D11", "D12"], "chapters": [31, 32, 33, 34, 35, 36], "families": 11, "themes": 47 }
    }
  },
  "enums": {
    "domain_ids": ["D01", "D02", "D03", "D04", "D05", "D06", "D07", "D08", "D09", "D10", "D11", "D12"],
    "part_romans": ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"],
    "annexe_codes": ["A", "B", "C", "D", "E"],
    "tome_ids": ["R", "T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8"],
    "relation_types": [
      "attenuation_risque",
      "dependance_technique",
      "operationnalisation",
      "encadrement_normatif",
      "concordance_inter_tomes",
      "tension_arbitrage",
      "amplification_synergie",
      "projection_temporelle"
    ],
    "interrelation_directions": ["sortante", "entrante"]
  },
  "oneOf": [
    { "$ref": "#/$defs/global_shard" },
    { "$ref": "#/$defs/domain_shard" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "domain_id": {
      "type": "string",
      "enum": ["D01", "D02", "D03", "D04", "D05", "D06", "D07", "D08", "D09", "D10", "D11", "D12"]
    },
    "global_shard": {
      "type": "object",
      "description": "Structure du shard maître Sources/Cartographie/donnees/prd_shards/prd-global-et-annexes.json.",
      "additionalProperties": false,
      "required": [
        "prd_title",
        "prd_subtitle",
        "toc_representative_title",
        "toc_intro_note",
        "metadata",
        "executive_summary",
        "parties",
        "annexes"
      ],
      "properties": {
        "prd_title": { "$ref": "#/$defs/non_empty_string" },
        "prd_subtitle": { "$ref": "#/$defs/non_empty_string" },
        "toc_representative_title": { "$ref": "#/$defs/non_empty_string" },
        "toc_intro_note": { "$ref": "#/$defs/non_empty_string" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "date", "status", "source_mindmap", "source_bundle"],
          "properties": {
            "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "status": { "$ref": "#/$defs/non_empty_string" },
            "source_mindmap": { "type": "string", "const": "Sources/Cartographie/MindMap - Cartographie thématique du Corpus.html" },
            "source_bundle": { "type": "string", "const": "Sources/Cartographie/donnees/corpus-mindmap-data.json" }
          }
        },
        "executive_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "lead", "sections"],
          "properties": {
            "title": { "type": "string", "const": "Sommaire exécutif global" },
            "lead": { "$ref": "#/$defs/non_empty_string" },
            "sections": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["heading", "body"],
                "properties": {
                  "heading": { "$ref": "#/$defs/non_empty_string" },
                  "body": { "type": "string", "minLength": 120 }
                }
              }
            }
          }
        },
        "parties": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/party_entry" }
        },
        "annexes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/annexe_entry" }
        }
      }
    },
    "party_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_number",
        "part_roman",
        "domain_id",
        "representative_part_title",
        "part_summary",
        "chapter_numbers"
      ],
      "properties": {
        "part_number": { "type": "integer", "minimum": 1, "maximum": 12 },
        "part_roman": {
          "type": "string",
          "enum": ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"]
        },
        "domain_id": { "$ref": "#/$defs/domain_id" },
        "representative_part_title": { "$ref": "#/$defs/non_empty_string" },
        "part_summary": { "type": "string", "minLength": 150 },
        "chapter_numbers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 36 }
        }
      }
    },
    "annexe_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annexe_code",
        "representative_title",
        "executive_summary",
        "targeted_content_description"
      ],
      "properties": {
        "annexe_code": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
        "representative_title": { "$ref": "#/$defs/non_empty_string" },
        "executive_summary": { "type": "string", "minLength": 150 },
        "targeted_content_description": { "type": "string", "minLength": 200 }
      }
    },
    "domain_shard": {
      "type": "object",
      "description": "Structure des six shards thématiques couvrant deux domaines consécutifs (D01-D02 à D11-D12).",
      "additionalProperties": false,
      "required": ["shard_id", "domains_covered", "chapters"],
      "properties": {
        "shard_id": {
          "type": "string",
          "enum": [
            "prd-d01-d02",
            "prd-d03-d04",
            "prd-d05-d06",
            "prd-d07-d08",
            "prd-d09-d10",
            "prd-d11-d12"
          ]
        },
        "domains_covered": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/domain_id" }
        },
        "chapters": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/chapter_entry" }
        }
      }
    },
    "chapter_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_number",
        "chapter_code",
        "domain_id",
        "subdomain_node_id",
        "representative_title",
        "executive_summary",
        "targeted_content"
      ],
      "properties": {
        "chapter_number": { "type": "integer", "minimum": 1, "maximum": 36 },
        "chapter_code": { "type": "string", "pattern": "^CH-(0[1-9]|[12][0-9]|3[0-6])$" },
        "domain_id": { "$ref": "#/$defs/domain_id" },
        "subdomain_node_id": { "type": "string", "pattern": "^SUB_D(0[1-9]|1[0-2])_0[1-3]$" },
        "representative_title": { "$ref": "#/$defs/non_empty_string" },
        "executive_summary": { "type": "string", "minLength": 300 },
        "targeted_content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_and_objectives",
            "key_requirements_and_objectives",
            "families_and_themes",
            "deliverables_and_verification",
            "cross_chapter_interrelations",
            "corpus_anchors"
          ],
          "properties": {
            "scope_and_objectives": { "type": "string", "minLength": 80 },
            "key_requirements_and_objectives": {
              "type": "array",
              "minItems": 4,
              "maxItems": 10,
              "items": { "$ref": "#/$defs/non_empty_string" }
            },
            "families_and_themes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/family_targeted" }
            },
            "deliverables_and_verification": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/non_empty_string" }
            },
            "cross_chapter_interrelations": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/interrelation_targeted" }
            },
            "corpus_anchors": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/corpus_anchor" }
            }
          }
        }
      }
    },
    "family_targeted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_node_id", "family_title", "family_overview", "themes_targeted"],
      "properties": {
        "family_node_id": { "type": "string", "pattern": "^FAM_D(0[1-9]|1[0-2])_0[1-3]_0[1-9]$" },
        "family_title": { "$ref": "#/$defs/non_empty_string" },
        "family_overview": { "type": "string", "minLength": 60 },
        "themes_targeted": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/theme_targeted" }
        }
      }
    },
    "theme_targeted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_node_id",
        "canonical_slug",
        "theme_title",
        "content_specification",
        "identifiers_and_norms"
      ],
      "properties": {
        "theme_node_id": { "type": "string", "pattern": "^THM_[a-z0-9-]+$" },
        "canonical_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "theme_title": { "$ref": "#/$defs/non_empty_string" },
        "content_specification": { "type": "string", "minLength": 60 },
        "identifiers_and_norms": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "interrelation_targeted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "relation_type",
        "target_chapter_number",
        "target_slug",
        "synthesis"
      ],
      "properties": {
        "direction": { "type": "string", "enum": ["sortante", "entrante"] },
        "relation_type": {
          "type": "string",
          "enum": [
            "attenuation_risque",
            "dependance_technique",
            "operationnalisation",
            "encadrement_normatif",
            "concordance_inter_tomes",
            "tension_arbitrage",
            "amplification_synergie",
            "projection_temporelle"
          ]
        },
        "target_chapter_number": { "type": "integer", "minimum": 1, "maximum": 36 },
        "target_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "synthesis": { "type": "string", "minLength": 30 }
      }
    },
    "corpus_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tome_id", "file", "reference"],
      "properties": {
        "tome_id": { "type": "string", "enum": ["R", "T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8"] },
        "file": { "type": "string", "pattern": "^Tomes/.+\\.md$" },
        "reference": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
