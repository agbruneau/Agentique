' Fig. 2. – Modèle de référence à cinq couches et plan de contrôle à trois volets
' Source : 4 - Plan Directeur (Chapitre M-9, p. 120)
@startuml
top to bottom direction
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName SansSerif
skinparam Padding 5
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 14

title
<b>Modèle de référence cible — Cinq couches et plan de contrôle en trois volets</b>
<size:11><color:#475569>Réconciliation C27 (ch. 23) et Plans transversaux A, B, C : le plan de contrôle possédé gouverne chaque couche</color></size>
end title

rectangle "<b>Clients, conseillers, réviseurs humains et agents externes mandatés (inter-organisations)</b>\n<color:#475569>Canaux numériques, postes de supervision instrumentés, réseaux de courtiers, dépositaires et partenaires accrédités</color>" as Actors #F8FAFC;line:94A3B8

together {
    rectangle Layers #FFFFFF;line:FFFFFF [
    |<#EFF6FF>  <b>Couche 1 — Interaction</b>  <color:#2563EB>interaction</color>\nInterfaces déclaratives bornées, supervision liée,\ntransparence Loi 25, agents externes  |
    |<#FFFFFF> |
    |<#EFF6FF>  <b>Couche 2 — Agents et orchestration</b>  <color:#2563EB>agents-orchestration</color>\nEnveloppe déterministe, exécution durable, sagas\nidempotentes, délégation anti-boucle  |
    |<#FFFFFF> |
    |<#EFF6FF>  <b>Couche 3 — Contexte et connaissance</b>  <color:#2563EB>contexte-connaissance</color>\nCouche sémantique, médiation sectorielle, contexte\ncompilé ACL, mémoire bi-temporelle  |
    |<#FFFFFF> |
    |<#EFF6FF>  <b>Couche 4 — Accès</b>  <color:#2563EB>acces</color>\nPasserelle à 5 contrôles, schémas d'outils signés,\npatrimoine, API bancaires ouvertes  |
    |<#FFFFFF> |
    |<#EFF6FF>  <b>Couche 5 — Modèles</b>  <color:#2563EB>modeles</color>\nRoutage d'inférence 3 paliers, bac à sable sans réseau,\ncontinuité bimodèle, résidence d'état  |
    ]

    rectangle ControlPlane #FFFFFF;line:0F172A [
    |<#0F172A>  <color:white><b>Plan de contrôle possédé</b></color>      |
    |<#ECFDF5>  <color:#166534><b>Volet A — Identité et sécurité</b></color>   \n<color:#475569>controle-identite-securite</color>\n• Identités NHI parrainées\n• Délégation atténuée par saut\n• PDP déterministe hors modèle\n• Coupe-circuit et agilité PQC   |
    |<#EFF6FF>  <color:#1D4ED8><b>Volet B — Observabilité & FinOps</b></color>   \n<color:#475569>controle-observabilite-finops</color>\n• Traces causales normalisées\n• Double couloir PII souverain\n• Homologation simulation/canari\n• Coût par résultat & Scope 3   |
    |<#F5F3FF>  <color:#6D28D9><b>Volet C — Gouvernance & registre</b></color>   \n<color:#475569>controle-gouvernance-registre</color>\n• Registre central & cote E-23\n• Matrice D1–D8 × Classes 1–6\n• Validation 2e/3e lignes\n• Tiers B-10 et réversibilité   |
    ]
}

rectangle "<color:#9A3412><b>Frontière d’intégrité : zéro écriture directe hors passerelle Couche 4 (idempotence & sagas)</b></color>" as Boundary #FFF7ED;line:C2410C;line.dashed

rectangle "<b>Systèmes d’enregistrement et infrastructures de règlement sectorielles</b>\n<color:#475569>Cœurs bancaires, gestion des contrats et sinistres, tenue de portefeuille, grand livre, rails ISO 20022 / RTR</color>" as Systems #F8FAFC;line:64748B

Actors -[hidden]down-> Layers
Actors -[hidden]down-> ControlPlane
Layers -[dotted]right- ControlPlane
Layers -[hidden]down-> Boundary
ControlPlane -[hidden]down-> Boundary
Boundary -[hidden]down-> Systems

@enduml
