    classDef noteBox fill:#F7F5F0,stroke:#C4BEB5,stroke-width:1px,color:#333333,text-align:left;
    class M1,M2,M3 card;
    class NOTE noteBox;
    style SG_MOM fill:#FFFFFF,stroke:none,color:#9E3A14
