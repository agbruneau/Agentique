%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'DejaVu Sans', 'fontSize': '14px', 'lineColor': '#334155', 'edgeLabelBackground': '#FFFFFF', 'primaryTextColor': '#0F2942'}, 'flowchart': {'nodeSpacing': 18, 'rankSpacing': 22, 'padding': 9}}}%%
flowchart TB
  subgraph FLOW[" "]
    direction LR
    subgraph INP["Entrée et séparation"]
      direction TB
      EXT["Sources externes et saisies<br/>(invites, outils, PII brutes)"]:::prob
      INF["Inférence modèle probabiliste<br/>(composant substituable)"]:::prob
      SPLIT["Harnais & séparateur déterministe<br/>(routage à la source, 0 brut)"]:::det
      EXT -.-> INF -.-> SPLIT
    end

    subgraph C1["Couloir 1 (branche inférieure) — Télémétrie (otel_pii_mapper.py)"]
      direction TB
      PII["Caviardage PII bilingue FR/EN<br/>(NAS, RAMQ, JWT → HMAC-SHA256)"]:::det
      OTEL["Mappage OTel v1.41.0 ↔ genai_dev<br/>(85 attr. Development, cache_write)"]:::det
      JOIN["Jointure trace ↔ mandat (lacune 21 :<br/>task_id, autonomy_level, approval.jti, cost_center)"]:::det
      PII --> OTEL --> JOIN
    end

    subgraph C2["Couloir 2 (branche supérieure) — Chaîne probatoire (audit_scitt_focus.py)"]
      direction TB
      JCS["Chaîne JCS RFC 8785<br/>(C.8, precedent_sha256, EXIG-OBS-12)"]:::det
      SCITT["Arbre de Merkle SCITT<br/>(RFC 9943, preuve d'inclusion)"]:::det
      SLH["Rescellement SLH-DSA<br/>(FIPS 205, vecteurs NIST ACVP)"]:::det
      JCS --> SCITT --> SLH
    end

    subgraph OUTP["Sortie FinOps"]
      direction TB
      CPO["Calculateur CPO exact (Decimal)<br/>(coût complet par résultat conforme)"]:::det
      FOCUS["Export FOCUS v1.4 et carbone<br/>(x_carbon_gco2e, x_energy_kwh, CAP-046)"]:::det
      CPO --> FOCUS
    end

    SPLIT --> PII
    SPLIT --> JCS
    JOIN --> CPO
    SLH --> CPO
  end

  subgraph LEG["Légende"]
    direction LR
    L_DET["Trait plein ardoise : frontière déterministe (G0)"]:::det
    L_PROB["Trait pointillé ambre : modèle probabiliste / non fiable"]:::prob
    L_DET ~~~ L_PROB
  end

  JOIN ~~~ L_DET

  classDef det fill:#EBF2F7,stroke:#1E4E79,stroke-width:2.5px,color:#0F2942,font-weight:bold
  classDef prob fill:#FFF5E0,stroke:#B45309,stroke-width:2px,stroke-dasharray:6 4,color:#451A03
  style FLOW fill:#FFFFFF,stroke:none
  style INP fill:#FFFFFF,stroke:none
  style OUTP fill:#FFFFFF,stroke:none
  style C1 fill:#F8FAFC,stroke:#64748B,stroke-width:1.2px,color:#334155
  style C2 fill:#F8FAFC,stroke:#64748B,stroke-width:1.2px,color:#334155
  style LEG fill:#FFFFFF,stroke:#CBD5E1,stroke-width:1.2px,color:#1E293B
  linkStyle 0,1 stroke:#B45309,stroke-width:2px,stroke-dasharray:6 4
