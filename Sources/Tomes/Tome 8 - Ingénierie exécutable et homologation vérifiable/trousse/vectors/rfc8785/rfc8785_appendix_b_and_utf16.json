  "section_3_2_2_and_3_2_4_sample": {
    "note": "Matches RFC 8785 § 3.2.2/3.2.3 & cyberphone/json-canonicalization testdata/output/values.json + outhex/values.txt (RFC 8785 § 3.2.4 prose hex dump had one extra 0x33 byte typo).",
    "input_json_text": "{\n\"numbers\": [333333333.33333329, 1E30, 4.50,\n2e-3, 0.000000000000000000000000001],\n\"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n\"literals\": [null, true, false]\n}",
    "expected_canonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
    "expected_utf8_hex": "7b226c69746572616c73223a5b6e756c6c2c747275652c66616c73655d2c226e756d62657273223a5b3333333333333333332e333333333333332c31652b33302c342e352c302e3030322c31652d32375d2c22737472696e67223a22e282ac245c75303030665c6e4127425c225c5c5c5c5c222f227d"
  },
  "section_3_2_3_utf16_sorting": {
    "input_json_text": "{\n\"\\u20ac\": \"Euro Sign\",\n\"\\r\": \"Carriage Return\",\n\"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n\"1\": \"One\",\n\"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n\"\\u0080\": \"Control\",\n\"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n}",
    "expected_value_order": [
      "Carriage Return",
      "One",
      "Control",
      "Latin Small Letter O With Diaeresis",
      "Euro Sign",
      "Emoji: Grinning Face",
      "Hebrew Letter Dalet With Dagesh"
    ],
    "expected_canonical": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\":\"Control\",\"ö\":\"Latin Small Letter O With Diaeresis\",\"€\":\"Euro Sign\",\"😀\":\"Emoji: Grinning Face\",\"דּ\":\"Hebrew Letter Dalet With Dagesh\"}"
  },
  "utf16_bmp_vs_astral_edge_case": {
    "note": "UTF-16 code unit sorting puts U+1F600 (D83D DE00) BEFORE U+FF00 (FF00), unlike UTF-8/UTF-32.",
    "input": {
      "＀": "bmp-ff00",
      "😀": "astral-1f600"
    },
    "expected_key_order": [
      "😀",
      "＀"
    ],
    "expected_canonical": "{\"😀\":\"astral-1f600\",\"＀\":\"bmp-ff00\"}"
  }
