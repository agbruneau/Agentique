@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle frame
skinparam nodesep 24
skinparam ranksep 30
skinparam padding 8

rectangle "Inférence du modèle\n(invites et réponses brutes)" as LLM <<prob>>
rectangle "Harnais d'agent déterministe\n(événements d'exécution)" as HARN <<det>>
rectangle "Séparateur déterministe de flux\n(routage à la source)" as SPLIT <<det>>

package "Couloir 1" {
  rectangle "Filtre de minimisation et\ncaviardage (renseignements\npersonnels, RP)" as REDACT <<det>>
  rectangle "Métadonnées OpenTelemetry GenAI\n(latence, jetons, erreurs sans RP)" as OTEL <<det>>
  rectangle "Supervision SRE et FinOps\n(exploitation courante)" as SRE <<ext>>
}

package "Couloir 2" {
  rectangle "Canonisation JCS (RFC 8785)\n(forme déterministe des preuves)" as JCS <<det>>
  rectangle "Chaînage SHA-256 et horodatage\n(intégrité cryptographique)" as HASH <<det>>
  database "Stockage immuable WORM\n(accès cloisonné par mandat)" as WORM <<det>>
  rectangle "Contrôleur de rétention\net purge légale" as PURGE <<det>>
  actor "Audit interne et régulateurs\n(accès justifié et tracé)" as AUD <<ext>>
}

LLM --> HARN : sortie brute
HARN --> SPLIT : événement complet
SPLIT -down-> REDACT
REDACT --> OTEL : zéro donnée\npersonnelle
OTEL --> SRE

SPLIT -down-> JCS
JCS --> HASH : empreinte liée
HASH --> WORM : écriture en ajout seul
PURGE --> WORM : cycle de conservation
WORM --> AUD : preuve opposable

REDACT -[hidden]right-> JCS

legend bottom
  **Trait plein ardoise** : frontière déterministe possédée
  **Trait pointillé ambre** : composant probabiliste substituable
  **Trait plein gris** : composant externe
end legend
@enduml
