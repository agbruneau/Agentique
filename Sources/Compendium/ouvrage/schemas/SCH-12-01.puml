@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Continuum patrimonial : façade MCP (≥ 92 %), CDC/EDI, transition BPMN/RPA → CUA (≤ 8 %) et Purdue

package "Z1 — Façade MCP anticorruption ≥ 92 % hors modèle (EXIG-ARC-14..18 / DEC-008)" {
  rectangle "① Outils d'intention métier bornés (MCP ≥ 92 %)\n(zéro CRUD 1:1 · zéro SQL direct sur ERP/SoR)" as N1 <<det>>
  rectangle "Propagation QSYS2.SET_CLIENT_INFO\n& clé d'idempotence cible" as N2 <<det>>
  N1 --> N2
}

package "Z2 — Traduction déterministe exacte (PEX-015), CDC/Outbox et médiation EDI/BAPI" {
  rectangle "② Transcodage EBCDIC (CP037/CP1147) ↔ UTF-8\n& Packed Decimal COMP-3 → Decimal (zéro float)" as N3 <<det>>
  rectangle "Formatage trames fixes & B2B\nCICS COMMAREA · SAP BAPI · EDI X12/EDIFACT" as N4 <<det>>
  database "③ Réplica CDC / CQRS Debezium & sas Purdue\n(protège MIPS mainframe & isole réseau OT)" as N5 <<green>>
  N2 --> N3
  N3 --> N4
  N2 --> N5
}

package "Z3 — Cœurs SoR, BPMN 2.0 / iPaaS et continuum Strangler Fig (MCP → CDC/EDI → RPA → CUA)" {
  database "Cœurs SoR préservés + tests Golden Master\n(IBM i, z/OS, SAP, ERP/CRM/WMS, parité SOX)" as N6 <<green>>
  rectangle "④ Coexistence BPMN 2.0 / iPaaS\n(Camunda/Zeebe · réconciliation EDI/ESB)" as N7 <<green>>
  rectangle "Strangler Fig (4 stades) : MCP ≥ 92 % → CDC/EDI\n→ RPA encadré → CUA ≤ 8 % (extinction ≤ 12 mois)" as N8 <<prob>>
  N4 --> N6 : Écriture idempotente
  N5 --> N6
  N7 .[#D97706].> N8
}

legend bottom
  **Bleu ardoise** : Adaptateur anticorruption MCP ≥ 92 % (EBCDIC, COMP-3 Decimal, CDC/Outbox, EDI)
  **Vert émeraude** : Cœurs transactionnels préservés (IBM i, z/OS, ERP, BPMN 2.0) et sas Purdue
  **Ambre pointillé** : Migration Strangler Fig (retrait graduel du RPA et extinction CUA ≤ 8 %)
end legend
@enduml
