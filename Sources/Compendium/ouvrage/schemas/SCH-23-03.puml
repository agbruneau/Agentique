@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.danger {
  BackgroundColor #FEF2F2
  LineColor #B91C1C
  LineThickness 2.0
  FontColor #7F1D1D
}
.ok {
  BackgroundColor #ECFDF5
  LineColor #047857
  LineThickness 2.2
  FontColor #064E3B
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 26
skinparam padding 7

title Le volant de distillation DSPy → Multi-LoRA : petits modèles 10× plus sobres
package "Z1 : Collecte qualifiée et sas Loi 25" {
  rectangle "Sagas réussies & arbitrages HOTL\nTraces validées en production" as COLL <<prob>>
  rectangle "Sas Loi 25 & canaris Carlini\nPurge irréversible RP + anti-mémorisation" as SAS <<det>>
}
package "Z2 : Compilation DSPy et affinage Multi-LoRA" {
  rectangle "Compilateur DSPy / MIPROv2\nSignatures typées optimisées" as DSPY <<det>>
  rectangle "Affinage SFT + DPO Multi-LoRA\nSLM 3B–8B si volume ≥ seuil V_min" as LORA <<prob>>
}
package "Z3 : Porte pass^5 ≥ 99 % et sentinelle ombre 2 %" {
  rectangle "Banc scellé E2 : porte pass^5 ≥ 99 %\nÉcart ≤ 1 % vs enseignant (zéro canari)" as GATE <<ok>>
  rectangle "Palier 1 du routeur frugal\nSLM promu + sentinelle ombre 2 % trafic" as PROD <<ok>>
  rectangle "Rejet / repli modèle maître\nÉchec pass^5, canari ou dérive > 1,5 pt" as REJ <<danger>>
}
COLL .[#B45309].> SAS : ① traces & corrections
SAS --> DSPY : ② jeu assaini vérifié
DSPY --> LORA : ③ volume ≥ V_min
LORA .[#B45309].> GATE : ④ examen probatoire
GATE --> PROD : pass^5 ≥ 99 % (écart ≤ 1 %)
GATE --> REJ : échec porte / canari
PROD --> REJ : ombre 2 % : dérive > 1,5 pt
legend bottom
  **Bleu collecte** : traces validées assainies Loi 25 et contrôlées par canaris Carlini
  **Ambre distillation** : compilation DSPy/MIPROv2 et adaptateurs SLM Multi-LoRA (volume ≥ V_min)
  **Vert qualification** : porte E2 pass^5 ≥ 99 % (écart ≤ 1 %) et sentinelle ombre 2 % (alerte > 1,5 pt)
end legend
@enduml
