@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title De vingt connecteurs fragiles (N×M) à neuf contrats ouverts (N+M) : ESB/SOA → REST/iPaaS → MCP/A2A

package "Z1 — Avant : Maillage point-à-point N×M inter-silos et échec FIPA-ACL" {
  rectangle "Coût quadratique C = (1+δ)(N×M)\nConnecteurs dédiés par silo (ERP, CRM, ITSM)" as N1 <<red>>
  rectangle "Leçon FIPA-ACL SC00061G\n(désaccord HTTP & taxe ontologique préalable)" as N2 <<red>>
  N1 .[#DC2626].> N2 : ① Explosion N(N−1)/2
}

package "Z2 — Après : Bus de contrats ouverts N+M (ESB/SOA → REST/iPaaS → MCP/A2A)" {
  rectangle "20 ans d'intégration : EAI · ESB/SOA\nREST/iPaaS · EDA (sans lourdeur FIPA-ACL)" as N3 <<det>>
  rectangle "Contrat unique par acteur (N+M)\nMCP · A2A · OpenAPI/gRPC · CloudEvents" as N4 <<det>>
  rectangle "Passerelle PEP, API Gateway & catalogue unique" as N5 <<det>>
  N2 --> N3 : ② Capitaliser ESB/SOA → REST/iPaaS
  N3 --> N4 : ③ Publier N+M contrats
  N4 --> N5
}

package "Z3 — Socle de l'invariant à quatre termes (Tome 1 § 1.0.2)" {
  rectangle "1. Découplage (espace, temps, format)\n2. Contrat explicite typé" as N6 <<green>>
  rectangle "3. Évolution SemVer (Deprecation/Sunset)\n4. Exploitation observable" as N7 <<green>>
  N5 --> N6 : ④ Vérifier 4 termes
  N6 --> N7
}

legend bottom
  **Corail alerte** : Maillage quadratique N×M non gouverné et dette d'intégration inter-silos
  **Bleu ardoise** : Contrats linéaires N+M (ESB/SOA Service-Oriented Architecture → REST/iPaaS → MCP/A2A)
  **Vert émeraude** : Invariant à quatre termes assurant la pérennité sans réécriture
end legend
@enduml
