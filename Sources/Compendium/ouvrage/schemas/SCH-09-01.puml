@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Passerelle d'agents bidirectionnelle (PEP) à neuf contrôles articulée à l'API Gateway / iPaaS d'entreprise

together {
  rectangle "Cellule appelante\nSPIFFE SVID + sub/act\nModèle sans clés (IAM-06)" as N1 <<det>>
  rectangle "Catalogue interne\n4e op. : approuver\nSHA-256 & paliers P0–P3" as N2 <<det>>
  rectangle "PDP & Approbation hors modèle\nh = SHA-256(JCS) · < 10 s" as N3 <<det>>
}

package "Passerelle d'agents — PEP bidirectionnel en échec fermé (EXIG-IAM-17)" {
  rectangle "ALLER · Contrôles 1 à 7 :\n(1) SVID/mTLS · (2) SHA-256 · (3) PDP P0–P3\n(4) I-JSON/anti-inj. · (5) jti/h · (6) Quotas · (7) RFC 8693" as N4 <<det>>
  rectangle "Pré-audit d'intention écrit AVANT relais P2/P3\n(EXIG-OBS-11 · Borealis-Bench 52,85 µs p50)" as N5 <<green>>
  rectangle "RETOUR · Contrôles 8 et 9 :\n(8) Masquage PII & retrait EXIG-SEC-06\n(9) Span OTel GenAI & journal JCS" as N6 <<green>>
  N4 --> N5 : ①② Pré-audit P2/P3
  N5 --> N6 : ③④ Retour filtré
}

together {
  rectangle "MCP 2026-07-28\nHTTP sans état · ≤ 15 outils" as N7 <<det>>
  rectangle "A2A v1.0.1\nAgent Card JWS/JCS" as N8 <<det>>
  rectangle "CloudEvents 1.0.2\nAsyncAPI · maxhops = 4" as N9 <<det>>
}

rectangle "API Gateway Nord-Sud, iPaaS & Event Mesh d'entreprise existants\n(façades ERP, CRM, SIRH, ITSM — zéro contournement de gouvernance API)" as N12 <<blue>>
rectangle "Règle de deux (EXIG-SEC-04) & retrait anti-exfiltration (EXIG-SEC-06)\nEntrée non fiable + Accès sensible → retrait immédiat outils d'envoi et P3" as N10 <<red>>
rectangle "Désambiguïsation du maillage (3 acceptions)\nRéseau (Istio/agentgateway) · Dorsale (Solace) · Confiance (AgentMesh, alpha)" as N11 <<gray>>

N1 --> N4
N2 <--> N4
N3 <--> N4
N6 <--> N7
N6 <--> N8
N6 <--> N9
N7 <--> N12
N9 <--> N12
N6 --> N10 : Marquage irréversible session
N12 -[hidden]right-> N11

legend bottom
  **Bleu ardoise / Bleu** : Contrôles aller 1 à 7 du PEP articulés en amont de l'API Gateway / iPaaS d'entreprise
  **Rouge** : Verrou de session Règle de deux (retrait P3/envoi) et arrêt immédiat
  **Vert émeraude** : Filtrage retour (contrôles 8 et 9), pré-audit P2/P3 et OTel
end legend
@enduml
