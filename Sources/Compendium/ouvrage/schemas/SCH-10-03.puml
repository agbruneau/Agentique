@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Compilateur déterministe du contexte (KV-cache en tête, ACL amont), RAG itératif et Skills signés

package "Z1 — Compilateur déterministe à strates fixes (ADR-008 / CAP-017)" {
  rectangle "① Préfixe invariant en tête (KV-cache chaud)\nConsignes, schémas & Agent Skills signés SHA-256" as N1 <<det>>
  rectangle "Assemblage borné & passage par référence\n(URI sous A2A · CAP-018)" as N2 <<det>>
  N1 --> N2
}

package "Z2 — Boucle RAG agentique : planifier → récupérer → critiquer → itérer" {
  rectangle "② Filtrage ACL du mandant EN AMONT\n(avant toute similarité vectorielle)" as N3 <<green>>
  rectangle "Récupération hybride\nDense DPR + BM25 → RRF → ColBERT / GraphRAG" as N4 <<green>>
  rectangle "③ Critique Self-RAG / Corrective RAG\n& Text-to-SQL gouverné (Spider 2.0)" as N5 <<prob>>
  rectangle "④ Compaction réversible au plafond jetons\nou abstention si preuves insuffisantes" as N6 <<amber>>
  N2 --> N3
  N3 --> N4
  N4 .[#D97706].> N5 : Évalue pertinence
  N5 .[#D97706].> N3 : Itération corrective
  N5 --> N6 : Seuil atteint
}

legend bottom
  **Bleu ardoise** : Strate fixe KV-cache et Agent Skills humains vérifiés en CI (CAP-018)
  **Vert émeraude** : Récupération hybride filtrée ACL en amont et validation
  **Ambre** : Boucle de rétroaction itérative et compaction au seuil budgétaire
end legend
@enduml
