@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Scellement SHA-256 et défense OAuth des outils MCP contre le rug-pull et 102 failles NVD

package "Z1 — Menaces vérifiées sur serveurs tiers (102 fiches NVD / ASI04)" {
  rectangle "Rug-pull (mutation silencieuse post-visa)\n& annotations mensongères (readOnlyHint)" as N1 <<red>>
  rectangle "Relais de jeton (token passthrough)\n& abus du mécanisme d'elicitation" as N2 <<red>>
}

package "Z2 — Sceau cryptographique au catalogue (EXIG-MCP-14..20)" {
  rectangle "Catalogue interne : JSON Schema 2020-12\n+ empreinte SHA-256 JCS (RFC 8785) + SemVer" as N3 <<det>>
  rectangle "Passerelle PEP : concordance Mcp-Method/Name\n(rejet HeaderMismatch au moindre octet)" as N4 <<det>>
  rectangle "Annotations déclaratives ignorées\n(seul le palier P0–P3 du catalogue fait foi)" as N5 <<det>>
  N3 --> N4 : ①② Contrôle à chaque appel
  N4 --> N5 : ③ Ignore hints
}

package "Z3 — Bouclier OAuth 2.1 sans relais de jeton" {
  rectangle "Serveur de ressources OAuth 2.1\nAudience unique (RFC 8707) & iss (RFC 9207)" as N6 <<green>>
  rectangle "Client ID Metadata Documents (≠ RFC 7591)\n& neutralisation elicitation (EXIG-MCP-21)" as N7 <<green>>
  N1 .[#B91C1C].> N4 : Bloqué par SHA-256 JCS
  N2 .[#B91C1C].> N6 : Bloqué par audience RFC 8707
  N5 --> N6
  N6 --> N7 : ④ Interdit secret/visa via elicitation
}

legend bottom
  **Rouge** : Surface d'attaque MCP (rug-pull, relais de jeton, 102 NVD, hints falsifiés)
  **Bleu ardoise** : Contrôle d'intégrité déterministe (SHA-256 JCS RFC 8785, HeaderMismatch)
  **Vert émeraude** : Identité et portée OAuth 2.1 (audience RFC 8707, validation iss RFC 9207)
end legend
@enduml
