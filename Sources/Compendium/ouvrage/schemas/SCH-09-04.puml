@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Aiguillage cognitif à trois paliers (SLM 70–78 %) et ordonnancement KV-cache Endpoint Picker

package "Z1 — Aiguilleur cognitif à trois paliers qualifié en E2 (EXIG-FIN-06)" {
  rectangle "Classifieur E2 (protection anti-éponge)\nÉvalue complexité et incertitude" as N1 <<det>>
  rectangle "Palier 1 : SLM (3B–14B)\n70–78 % des appels bornés" as N2 <<green>>
  rectangle "Palier 2 : LLM frontière\nIntentions complexes" as N3 <<prob>>
  rectangle "Palier 3 : Calcul réflexif\n(test-time compute sous plafond FinOps)" as N4 <<prob>>
  N1 --> N2 : ① Voie frugale par défaut
  N1 .[#D97706].> N3 : ④ Escalade incertitude
  N1 .[#D97706].> N4 : Raisonnement profond
}

package "Z2 — Ordonnanceur Gateway API Inference Extension (EPP / llm-d)" {
  rectangle "Endpoint Picker (EPP / EXIG-FIN-07)\nInspecte empreinte préfixe & files VRAM" as N5 <<det>>
  rectangle "Réplique GPU avec KV-cache chaud\n(RadixAttention · réutilisation préfixe KV)" as N6 <<green>>
  rectangle "Désagrégation prefill / decode\n(remplace répartition circulaire aveugle)" as N7 <<det>>
  N2 --> N5 : ② Sélection réplique
  N3 .[#D97706].> N5
  N5 --> N6 : ③ Hit KV-cache chaud (TTFT réduit)
  N5 --> N7 : Délestage charge
}

legend bottom
  **Vert émeraude** : Voie frugale SLM (70–78 %) et hit KV-cache chaud en VRAM
  **Bleu ardoise** : Ordonnanceur Endpoint Picker et préfixes déterministes stables
  **Ambre pointillé** : Escalade vers LLM frontière ou calcul réflexif sous plafond budgétaire
end legend
@enduml
