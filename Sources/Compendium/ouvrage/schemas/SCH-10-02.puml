@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Données prêtes pour agents : sas Write-Audit-Publish (ODCS v3.2.0), référentiels sectoriels et ISO 20022 (Lynx/RTR)

package "Z1 — Sas Write-Audit-Publish multi-systèmes (Iceberg/Nessie & ODCS v3.2.0)" {
  rectangle "① Write : branche isolée de quarantaine\nFlux ERP/CRM · GS1/UBL · HL7 FHIR · ISA-95/OPC UA · FIBO" as N1 <<amber>>
  rectangle "② Audit : contrôleur sémantique ODCS v3.2.0\n(unités, dérive PSI, fraîcheur, OpenLineage)" as N2 <<amber>>
  rectangle "Publish : données certifiées au catalogue d'entreprise" as N3 <<green>>
  N1 --> N2
  N2 --> N3 : Promotion validée
}

package "Z2 — Exposition gouvernée sous identité du mandant (EXIG-ARC-16)" {
  rectangle "③ Accès MCP sous identité déléguée du mandant\n(zéro compte de service · étiquette juridique)" as N4 <<green>>
  N3 --> N4
}

package "Z3 — Barrière d'irréversibilité : étalon ISO 20022 (Lynx achevé, RTR reporté), ERP & OT" {
  rectangle "Rail Lynx ISO 20022 (migration achevée nov. 2025)\n& grands livres ERP / consignes OT" as N5 <<green>>
  rectangle "Rail RTR (reporté après 4 cibles)\nRèglement n° 10 DORS/2026-133 (août 2026)" as N6 <<amber>>
  rectangle "④ Barrière d'irréversibilité (Tome 1 § 45.12)\nObservation et préparation sans exécution autonome" as N7 <<red>>
  N4 --> N7
  N7 --> N5 : Lecture / dossier normalisé
  N7 ..> N6 : Veille RTR
}

legend bottom
  **Ambre** : Branche de quarantaine Write-Audit (flux sectoriels) et rail RTR en attente
  **Vert émeraude** : Données certifiées ODCS v3.2.0 (Publish) et rail Lynx ISO 20022 opérationnel
  **Rouge** : Barrière d'irréversibilité (aucune exécution autonome sur Lynx, ERP critique ou OT)
end legend
@enduml
