@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Autopsie des 14 pannes MAST (1 642 traces) et arbitrage mono-agent / collectif

package "Z1 — Répartition des 14 modes d'échec MAST v3 (1 642 traces)" {
  rectangle "FM-1 : Conception & spécification\n(44,2 % des pannes)" as N1 <<red>>
  rectangle "FM-2 : Désalignement inter-agents\n(32,3 % · perte de contexte)" as N2 <<red>>
  rectangle "FM-3 : Vérification & terminaison\n(23,5 % sur 7 cadriciels)" as N3 <<red>>
}

package "Z2 — Arbitrage économique et cognitif" {
  rectangle "Rédacteur unique continu\n(coût 1× · zéro friction inter-agents)" as N4 <<green>>
  rectangle "Collectif multi-agents libre\n(surcoût ~15× jetons · 58–515 % coord.)" as N5 <<amber>>
  rectangle "Effet Ringelmann (1,2–1,8 sur 30)\nÉcart −70 % (séquentiel) à +80,8 % (parallèle)" as N6 <<amber>>
}

package "Z3 — Conditions strictes d'autorisation (EXIG-ORC-01 / ORC-02)" {
  rectangle "Proscription des chambres d'écho\net débats libres non bornés" as N7 <<red>>
  rectangle "Ouverture multi-agents conditionnelle\n(parallélisme prouvé ou séparation sécurité)" as N8 <<green>>
  rectangle "Preuve de gain pass^k et CPO\nrequise face au mono-agent" as N9 <<green>>
}

N4 --> N1 : ① Partir du mono-agent
N1 --> N2 : ② Auditer risques MAST
N2 --> N3
N5 .[#D97706].> N6 : ③ Écarter débats libres
N6 --> N7
N3 --> N8 : ④ Démontrer gain pass^k/CPO
N8 --> N9

legend bottom
  **Rouge** : Causes architecturales et coordination MAST (44,2 % + 32,3 %)
  **Ambre** : Zone de surcoût 15× et baisse de performance (−70 %) sur tâches séquentielles
  **Vert émeraude** : Parcimonie validée (rédacteur unique continu ou parallélisme prouvé)
end legend
@enduml
