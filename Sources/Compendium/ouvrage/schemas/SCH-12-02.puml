@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Continuum MCP ≥ 92 % → CDC/EDI → RPA → CUA ≤ 8 % (12 mois) et sas industriel IT/OT (Purdue, Simplex)

package "Z1 — Continuum patrimonial sans API (ADR-016) et extinction CUA à 12 mois" {
  rectangle "① MCP ≥ 92 % → CDC/EDI → RPA déterministe\n(grattage client externe proscrit PEX-001)" as N1 <<green>>
  rectangle "② Exception CUA interne confinée (≤ 8 %)\nCaviardage PII, double OCR, blocage touches" as N2 <<prob>>
  rectangle "Compte à rebours ≤ 12 mois (INI-015)\n→ Interdiction totale à POR-008" as N3 <<red>>
  N1 --> N2 : Si absence API
  N2 .[#D97706].> N3 : Extinction ≤ 12 mois
}

package "Z2 — Sas industriel IT/OT (Purdue / IEC 62443-3-3 SL-3, CAP-028 : ERP ↔ MES ↔ SCADA)" {
  database "Réplica IDMZ niveau 3.5 Purdue (lecture seule)\ndevant OPC UA, AAS & MQTT Sparkplug B" as N4 <<green>>
  rectangle "③ Agrégation FFT/RMS & validation\njumeau numérique FMI 3.0 Ed25519" as N5 <<det>>
  rectangle "Arbitre matériel Simplex & exclusion SIL 2+\n(rejet écriture directe PLC/SCADA)" as N6 <<green>>
  N4 --> N5
  N5 --> N6
}

package "Z3 — Cellule Edge Local-First déconnectée (ADR-028 / 72 h)" {
  rectangle "④ SLM local + attestation SPIRE / TPM 2.0\n& synchronisation CRDT sous quotas" as N7 <<prob>>
  rectangle "Repli automatique en palier L1\nau-delà de 72 h sans WAN" as N8 <<red>>
  N7 .[#B91C1C].> N8 : Déconnexion > 72 h
}

legend bottom
  **Rouge** : Interdictions absolues (grattage externe LSAC, écriture PLC/SCADA, CUA > 12 mois)
  **Ambre pointillé** : Dérogation transitoire CUA confinée (≤ 8 %) et cellule Edge 72 h
  **Vert émeraude** : Continuum durable MCP ≥ 92 % / CDC / EDI, réplica Purdue IDMZ 3.5 et Simplex
end legend
@enduml
