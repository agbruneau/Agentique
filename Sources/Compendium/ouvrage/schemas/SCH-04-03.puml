@startuml
<style>
document { BackgroundColor #FFFFFF; }
.det { BackgroundColor #EBF2F7; LineColor #1B4F72; LineThickness 2.2; FontColor #0F2942; }
.blue { BackgroundColor #EFF6FF; LineColor #1D4ED8; LineThickness 2.2; FontColor #1E3A8A; }
.prob { BackgroundColor #FFF5E0; LineColor #D97706; LineThickness 2.0; LineStyle 5; FontColor #451A03; }
.amber { BackgroundColor #FFFBEB; LineColor #B45309; LineThickness 2.0; FontColor #451A03; }
.green { BackgroundColor #ECFDF5; LineColor #047857; LineThickness 2.2; FontColor #064E3B; }
.teal { BackgroundColor #F0FDFA; LineColor #0F766E; LineThickness 2.2; FontColor #134E4A; }
.red { BackgroundColor #FEF2F2; LineColor #B91C1C; LineThickness 2.2; FontColor #7F1D1D; }
.purple { BackgroundColor #F5F3FF; LineColor #6D28D9; LineThickness 2.2; FontColor #4C1D95; }
.indigo { BackgroundColor #EEF2FF; LineColor #4338CA; LineThickness 2.2; FontColor #312E81; }
.gray { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.8; FontColor #1E293B; }
package { BackgroundColor #F8FAFC; LineColor #64748B; LineThickness 1.2; FontColor #334155; }
legend { BackgroundColor #FFFFFF; LineColor #CBD5E1; FontColor #1E293B; FontSize 11; }
</style>
hide stereotype
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 28
skinparam padding 7

top to bottom direction
title Usine logicielle (AST/SCIP), muraille Oracle–Bâtisseur et modernisation patrimoniale vers Outbox/CDC

package "Z1 — Séparation des devoirs SPIFFE : Spécificateur face au Bâtisseur" {
  rectangle "Parseur AST/SCIP & ANTLR/Tree-sitter\n(RPG/COBOL · ABAP/ERP · PL/SQL · DB2)" as N1 <<indigo>>
  rectangle "Agent Spécificateur (SPIFFE)\nRédige specs + oracle Golden Master / Z3 (10k–100k)" as N2 <<indigo>>
  rectangle "Agent Bâtisseur confiné (sans réseau)\nCode en Rust/Go/Java · Decimal exact (zéro specs/tests)" as N3 <<det>>
  N1 --> N2 : ① Verrouiller oracle
  N2 --> N3 : ② Spécifications figées
}

package "Z2 — Barrière de vérification : propriétés et mutation" {
  rectangle "Tests par propriétés\n(rejet de la simple couverture de lignes)" as N4 <<indigo>>
  rectangle "Mutation calibrée Meta ACH\n(minMutationKillScore: 0.88)" as N5 <<indigo>>
  rectangle "Porte sdlc-modernization-gate.yaml" as N6 <<det>>
  N3 --> N4 : ③ Filtrer production
  N4 --> N5
  N5 --> N6
}

package "Z3 — Figuier étrangleur patrimonial et comparateur Shadow Mirroring" {
  rectangle "Cœurs patrimoniaux (RPG/COBOL, ABAP/ERP, PL/SQL)\nen parallèle du service MCP moderne" as N7 <<green>>
  rectangle "Comparateur de parité Decimal & métier\n(0,00 $ d'écart sur ≥ 100 000 tx)" as N8 <<green>>
  rectangle "Bascule graduelle & Outbox/CDC < 200 ms\n(extinction progressive des écrans RPA/CUA)" as N9 <<green>>
  N6 --> N7 : ④ Shadow Mirroring
  N7 --> N8
  N8 --> N9
}

legend bottom
  **Indigo** : Agent Spécificateur / Oracle indépendant (RPG/COBOL, ABAP/ERP, PL/SQL) et suite Golden Master / Z3
  **Bleu ardoise** : Agent Bâtisseur confiné sans réseau et service moderne en arithmétique Decimal exacte
  **Vert émeraude** : Comparateur Shadow Mirroring (0,00 $ d'écart) et réplication Outbox/CDC < 200 ms
end legend
@enduml
