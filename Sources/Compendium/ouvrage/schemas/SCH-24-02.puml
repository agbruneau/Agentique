@startuml
<style>
document {
  BackgroundColor #FFFFFF
}
.det {
  BackgroundColor #EBF2F7
  LineColor #1E4E79
  LineThickness 2.5
  FontColor #0F2942
}
.prob {
  BackgroundColor #FFF5E0
  LineColor #B45309
  LineThickness 2.0
  LineStyle 5
  FontColor #451A03
}
.danger {
  BackgroundColor #FEF2F2
  LineColor #B91C1C
  LineThickness 2.0
  FontColor #7F1D1D
}
.ok {
  BackgroundColor #ECFDF5
  LineColor #047857
  LineThickness 2.2
  FontColor #064E3B
}
.ext {
  BackgroundColor #F3F4F6
  LineColor #4B5563
  LineThickness 1.5
  FontColor #111827
}
package {
  BackgroundColor #F8FAFC
  LineColor #64748B
  LineThickness 1.2
  FontColor #334155
}
legend {
  BackgroundColor #FFFFFF
  LineColor #CBD5E1
  FontColor #1E293B
  FontSize 10
}
</style>
hide stereotype
top to bottom direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 26
skinparam padding 7

title GitOps agentique à trois objets indissociables (agent + outil + politique)
package "Z1 : Dépôt GitOps unifié (Triplet versionné)" {
  rectangle "1. Manifeste & invites d'agent\nMandat NHI et paramètres" as OBJ1 <<det>>
  rectangle "2. Contrats & SHA-256 MCP\nSchémas d'outils épinglés" as OBJ2 <<det>>
  rectangle "3. Politiques OPA / Cedar\nPlafonds et règles hors modèle" as OBJ3 <<det>>
}
package "Z2 : Portes CI/CD, SLSA et promotion progressive" {
  rectangle "Portes CI E1–E2 & Sigstore/SLSA\nArtefact composite SemVer+Intent (0 latest)" as CI <<ok>>
  rectangle "Déploiement fantôme → canari\nÉpinglage workflows Temporal en vol" as CAN <<det>>
}
package "Z3 : Réévaluation complète et retour arrière" {
  rectangle "Détecteur d'évolution modèle\nSeuil d'impact invite/mémoire" as DRIFT <<prob>>
  rectangle "Retour arrière atomique\n& ré-homologation complète" as ROLL <<danger>>
}
OBJ1 --> CI : ① requête de fusion unique
OBJ2 --> CI
OBJ3 --> CI
CI --> CAN : ② artefact scellé SLSA
CAN --> DRIFT : ③ observation en continu
DRIFT .[#B45309].> ROLL : ④ dérive > seuil
ROLL --> CI : relance cycle E1–E2
legend bottom
  **Bleu GitOps** : triplet indissociable (agent + outil + politique) et épinglage Temporal
  **Vert promotion** : portes CI E1–E2, attestation SLSA/Sigstore et déploiement Shadow/Canary
  **Ambre / Rouge** : retour arrière atomique et ré-homologation sur évolution du modèle
end legend
@enduml
